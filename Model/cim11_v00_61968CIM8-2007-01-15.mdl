						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "grantDate"
						quid       	"3AA8051E01B8"
						documentation 	" Date that grant became official."
						type       	"AbsoluteDate"
						exportControl 	"Public")
					    (object ClassAttribute "propertyData"
						quid       	"3AA8051F0064"
						documentation 	" Property related information that describes the Grant's land parcel.  For example, it may be a deed book number, deed book page number, and parcel number."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "RightOfWay"
					quid       	"3AA805290212"
					documentation 	" A right-of-way (ROW) is for land where it is lawful to use for a public road, an electric power line, etc. Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
