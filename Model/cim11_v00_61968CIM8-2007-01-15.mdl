		    (object Class_Category "Documentation"
			quid       	"3AA8054803B6"
			documentation 	
|The Documentation Package contains sub-packages (themes) for real world objects that are largely document oriented (e.g., Work Order, Trouble Ticket, Safety Document, etc.).
|
			
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "DocumentationVersion"
				quid       	"4509ABDC002E"
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "version"
					quid       	"4509ABEA02EE"
					initv      	"Documentation_v008")
				    (object ClassAttribute "date"
					quid       	"4509ABED0203"
					initv      	"2006-09-15")))
			    (object Class_Category "DataSets"
				quid       	"3AA8054901F4"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "ChangeSet"
					quid       	"3AA8057603D4"
					documentation 	"The updates required in a transaction for an existing data set are grouped into a single ChangeSet.  In data sets (e.g., NetworkDataSet), each major step in the ChangeSet is described through a separate ChangeItem associated with the data set.  Within each data set, each inidividual object change is described with a seperate ChangeItem associated with the object.  "
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"41D0511002C4"
						supplier   	"Logical View::61968::Core2::Collections::Collection"
						quidu      	"3AA804EC02DA")))
				    (object Class "NetworkDataSet"
					quid       	"3AA805770212"
					documentation 	"Categorized as a type of document, a network data set is a model of a portion of the electrical network that includes a list of the equipment, along with relevant connectivity, electrical characteristics, geographical location, and various parameters associated with the equipment."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
