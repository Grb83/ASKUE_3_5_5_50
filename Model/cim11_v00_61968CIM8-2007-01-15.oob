<a:DataType>AbsoluteDateTime</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o2178">
<a:ObjectID>F12685A4-06CA-40DE-A021-B3A834C21C04</a:ObjectID>
