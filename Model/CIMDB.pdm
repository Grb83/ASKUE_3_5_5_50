<a:Creator>sechin</a:Creator>
<a:ModificationDate>1201276008</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Pulse high limit which is the largest control pulse that the unit can respond to</a:Comment>
<a:DataType>NUMBER</a:DataType>
<a:Mandatory>1</a:Mandatory>
</o:Column>
<o:Column Id="o1305">
<a:ObjectID>E5378B76-724D-4B7B-8CFD-06E33DCA084A</a:ObjectID>
