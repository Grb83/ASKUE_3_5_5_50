		    (object Class_Category "ERP_Support"
			quid       	"3AFFEEC901E0"
			documentation 	
|The Enterprise Resource Planning (ERP) Support  Package contains portions of the model defined by ERP standards like those proposed by the Open Applications Group (OAG).  This package is provided to facilitate integration among electric utility applications (CIM) and enterprise resource planning (ERP) applications (as defined by OAG).  Rather than inventing new CIM classes that accomplish similar functionality as in existing ERP models, the preferred approach is to use and extend ERP classes as appropriate in other packages.   
|
|If a model other that the OAG standard is used as a basis for ERP integration, the utility classes labeld "Erp..." should be associated with the appropriate classes of that standard. In fact, definitions of "Erp..." classes are based on OAG Nouns to facilitate this process. 
			
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "ErpSalesOrder"
				quid       	"3AFFEF7D008C"
				documentation 	
|General purpose Sales Order is used for utility service orders, etc.  
|
|As used by the OAG, the SalesOrder is a step beyond a PurchaseOrder in that the receiving entity of the order also communicates SalesInformoration about the Order along with the Order itself. 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE2290120"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpAddress"
				quid       	"3AFFF09D00DC"
				documentation 	"General purpose address information used for utilities.  Where sufficient, fields are used from the ERP model.  However, to support additional querying that is typical of utilities, the address line is broken into more specific fields."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"435CE3F2002E"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "streetNumber"
					quid       	"3C570586030C"
					documentation 	"The designator of the specific location on the street."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "streetName"
					quid       	"3C57059B017C"
					documentation 	"The name of the street."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "streetSuffix"
					quid       	"3C5707650050"
					documentation 	"Suffix to the street name.  For examle, North, South, East, West.  "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "streetPrefix"
					quid       	"3C57082501A4"
					documentation 	"Prefix to the street name.  For examle, North, South, East, West.  "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "streetType"
					quid       	"3C5708680258"
					documentation 	"Type of street.  Examples include: street, circle, boulevard, avenue, road, drive,  etc."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "poBox"
					quid       	"3C5705B501A4"
					documentation 	"The post office box."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "suiteNumber"
					quid       	"3C57092A0398"
					documentation 	"The number of the apartment or suite."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "addressGeneral"
					quid       	"3C570993000A"
					documentation 	"Additional address information, for example a mailstop."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "townCode"
					quid       	"3C8FD803035C"
					documentation 	"The code for a particular town."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "section"
					quid       	"3D74C823000E"
					documentation 	"A Section is part of a township. For example, it is common for there to be 36 section per township."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "city"
					quid       	"3F69076B001F"
					documentation 	"Name of city."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "stateOrProvince"
					quid       	"3F69077103DF"
					documentation 	"Name of the state or province."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "country"
					quid       	"3F69077D0332"
					documentation 	"Name of the country."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "postalCode"
					quid       	"3F69078300D7"
					documentation 	"Postal code for the address."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "ErpPerson"
				quid       	"3AFFF16603CA"
				documentation 	"General purpose information for name and other information to contact people."
				superclasses 	(list inheritance_relationship_list
