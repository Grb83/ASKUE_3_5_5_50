<a:ObjectID>2B12EED9-3076-4702-A618-C25BBDE8E278</a:ObjectID>
<a:Name>LOCATIONSTRING</a:Name>
<a:Code>LOCATIONSTRING</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A location string is a text string which should describe the location.</a:Comment>
<a:Stereotype>GML</a:Stereotype>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
</o:Class>
<o:Class Id="o5180">
<a:ObjectID>0D1BF6A5-5059-4824-B5BE-53AE3177B391</a:ObjectID>
<a:Name>METADATA</a:Name>
