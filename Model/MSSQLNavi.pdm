<a:Code>TR_gate_event_message_span_msg</a:Code>
<a:Text>CREATE TRIGGER TR_gate_event_message_span_msg   ON gate_event   FOR DELETE   AS    DELETE FROM gate_event_message_span WHERE gate_event_id IN (SELECT gate_event_id FROM DELETED);
