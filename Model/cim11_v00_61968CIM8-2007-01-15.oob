<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Flag = YES if equipment must be grounded</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o6469">
<a:ObjectID>757C9B09-405C-4035-9EEC-9B6ECC134C37</a:ObjectID>
