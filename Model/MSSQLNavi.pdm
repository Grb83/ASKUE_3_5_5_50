<a:Text>CREATE TRIGGER FK_cmd_gate_event_expression_evaluator_evaluator_condition_cascade   ON evaluator_condition   FOR DELETE   AS    DELETE FROM gate_event_expression_evaluator_evaluator_condition WHERE evaluator_condition_id IN (SELECT evaluator_condition_id FROM DELETED );
