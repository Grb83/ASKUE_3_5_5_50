				    (object Class "DuctBank"
					quid       	"3AA8046B01EA"
					documentation 	" A duct bank may contain many ducts.  Each duct contains individual lines that are expressed as linear assets (thereby describing each line's physical asset characteristics), which are each associated with ACLineSegments and other classes describing their electrical characteristics."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
