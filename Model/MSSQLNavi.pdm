<a:Name>FK_cmd_queue_item_client_user_id_cascade</a:Name>
<a:Code>FK_cmd_queue_item_client_user_id_cascade</a:Code>
<a:Text>CREATE TRIGGER FK_cmd_queue_item_client_user_id_cascade   ON cmd_queue   FOR DELETE   AS    DELETE FROM cmd_queue_item WHERE queue_id IN (SELECT cmd_queue_id FROM DELETED);
go</a:Text>
