<o:Trigger Id="o1196">
<a:ObjectID>8205A3E9-1B4F-4097-8953-5A83738D818A</a:ObjectID>
<a:Name>S_3MIN_HOLES</a:Name>
<a:Code>S_3MIN_HOLES</a:Code>
<a:Text>create trigger &quot;ASKUEDB&quot;.s_3min_holes
after insert or update on s_3min
for each row
敢楧੮ⴊभ晩⠠为坅爮损摯⁥‼〱‰牯㨠䕎⹗彲潣敤㸠‽〲⤰愠摮渠瑯㨠䕎⹗彲潣敤椠⁮㈨㄰‬〲ⰲ㈠㌰‬〲⤴琠敨੮ⴭउ慲獩彥灡汰捩瑡潩彮牥潲⡲㈭〰㈰‬䠧䱏卅䍟䕎⹔彳洳湩桟汯獥琠楲杧牥›慣⁮潮⁴敤敬整栠汯⁥潲⁷畤⁥潴椠癮污摩爠损摯獥⤧਻ⴭ攉摮椠㭦ਊⴭ椉⁦为坅爮损摯⁥湩⠠ㄱⰲㄠ㌱‬㈱ⰸㄠ㤲‬㐱ⰴㄠ㔴‬㘱ⰰㄠㄶ 桴湥ⴊभ爉楡敳慟灰楬慣楴湯敟牲牯⴨〲〰ⰳ✠佈䕌当乃呅献㍟業彮潨敬⁳牴杩敧㩲挠湡渠瑯搠汥瑥⁥潨敬爠睯搠敵琠⁯畳档爠损摯獥⤧਻ⴭ攉摮椠㭦ਊ搉汥瑥⁥牦浯栠汯獥㍟業੮眉敨敲漉橢楟⁤†††‽为坅漮橢楟੤उ湡⁤潰湩彴摩㴠㨠䕎⹗潰湩彴摩ऊ愉摮琠⁳†††‽为坅琮㭳ਊ湥⁤彳洳湩桟汯獥਻</a:Text>
<a:CreationDate>1205245117</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1205245117</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Time>after</a:Time>
<a:Event>insert or update</a:Event>
<c:Trigger.Owner>
<o:User Ref="o551"/>
</c:Trigger.Owner>
</o:Trigger>
</c:Triggers>
<c:PrimaryKey>
<o:Key Ref="o1195"/>
</c:PrimaryKey>
</o:Table>
