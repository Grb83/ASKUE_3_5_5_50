				    (object ClassAttribute "suffix"
					quid       	"4419349F0251"
					documentation 	"A suffix for the person's name, such as II, III, etc."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "ErpPersonnel"
				quid       	"3AFFF3B70262"
				documentation 	"Information that applies to the basic data about a utility person.  This is used by ERP applications to transfer Personnel data for a worker."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1CF001C"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpCompetency"
				quid       	"3AFFF4280104"
				documentation 	"Information that describes aptitudes of an utility employee.  Unlike Skills that a ErpPerson must be certified to perform before undertaking certain type of assignments (to be able to perfrom a Craft), ErpCompetency has more to do with typical Human Resource (HR) matters such as schooling, training, etc. "
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1CB0215"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpSiteLevelData"
				quid       	"3AFFF4D003DE"
				documentation 	
|For a utility, general information that describes physical locations of organizations or the location codes and their meanings.  
|
|This enables ERP applications to ensure that the physical location identifiers are synchronized between the business applications. 
|
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1F50139"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpInventory"
				quid       	"3AFFF59A01CC"
				documentation 	
|Utility inventory related information about an item or part. This data type is not for describing the item and its attributes.
|
|This is used by ERP applications  to enable the synchronization of Inventory data that exists on separate Item Master databases.  This data is not the master data that describes the attributes of the item such as dimensions, weight, or unit of measure.  This is data that describes the ITEM as it exists at a specific location.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1B602B5"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpIssueInventory"
				quid       	"3AFFF80A0168"
				documentation 	
|The ErpIssueInventory can be used to request an application to process an issue or request information about an issue.
|
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1C30051"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpPayable"
				quid       	"3AFFF8AE03CA"
				documentation 	
|Payable is a transaction that represents an invoice from a supplier.  A payable (or voucher) is an open item, approved and ready for payment, in the Accounts Payable ledger.
|
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE220038A"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpProjectAccounting"
				quid       	"3AFFF91D03D4"
				documentation 	
|Utility Project Accounting information.  This is used by ERP applications to enable all relevant sub-systems that submit single sided transactions to transfer information with a Project Accounting Application. This would include, but not necessarily be limited to: Accounts Payable, Accounts Receivable, Budget, Order Management, Purchasing, Time and Labor, Travel and Expense.
|
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE2010303"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpBOM"
				quid       	"3AFFF9F70172"
				documentation 	
|Information that generally describes the Bill of Material Structure and it's contents for a utility.
|
|This is used by ERP systems to transfer of Bill of Material information between two business applications.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"441FCB97000F"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpRequisition"
				quid       	"3AFFFAE3003C"
				documentation 	"General information that applies to a utility requisition that is a request for the purchase of goods or services.  Typically, a requisition leads to the creation of a purchase order to a specific supplier."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1FE0100"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpChartOfAccounts"
				quid       	"3B0012A40082"
				documentation 	"Chart of Accounts represents the accounting structure of a business.   Each account represents a financial aspect of a business, such as its Accounts Payable, or the value of its inventory, or its office supply expenses."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE20500BA"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpEngChangeOrder"
				quid       	"3B00162000E6"
				documentation 	"General Utility Engineering Change Order information.  "
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE20D010B"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpInventoryCount"
				quid       	"3B0016DB01D6"
				documentation 	
|This is related to Inventory physical counts organized by AssetModel.  Note that a count of a type of asset can be accomplished by the association inherited by AssetModel (from Document) to Asset.
|
|It enables ERP applications to transfer an inventory count between ERP and the actual physical inventory location. This count may be a cycle count or a physical count. 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"442131020148"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpLedgerBudget"
				quid       	"3B0018AD0316"
				documentation 	"This is for information for utility Ledger Budgets.  They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE22D011C"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpPurchaseOrder"
				quid       	"3B026EEA010E"
				documentation 	
|A PurchaseOrder is a document that communicates an order to purchase goods from a buyer to a supplier. The PurchaseOrder carries information to and from the buyer and supplier. The PurchaseOrder is a legally binding document once both Parties agree to the contents and the specified terms and conditions of the order. 
|
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE21C02E4"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpReceiveDelivery"
				quid       	"3B0270DA008C"
				documentation 	"This represents a transaction for an Organisation receiving goods or services.  It may be used to indicate receipt of goods in conjunction with a purchase order. A receivable is an open (unpaid) item in the Accounts Receivable ledger."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE21600D2"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A")))
			    (object Class "ErpBomItemData"
				quid       	"3BB9C7020140"
				documentation 	"An individual item on a bill of materials."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECFE1EB02C5"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")))
			    (object Class "ErpTelephoneNumber"
