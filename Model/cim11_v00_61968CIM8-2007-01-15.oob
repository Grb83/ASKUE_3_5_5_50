<a:Comment>True when the meter is an electricity meter.</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o1084">
<a:ObjectID>99DC8140-8E01-4033-93D0-E49643D8EF72</a:ObjectID>
<a:Name>gasMeter</a:Name>
<a:Code>gasMeter</a:Code>
