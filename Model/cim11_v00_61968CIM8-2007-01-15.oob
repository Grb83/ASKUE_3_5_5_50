<o:Class Id="o3891">
<a:ObjectID>C09BDE1A-79B3-42B1-9A2C-3EAC0170E094</a:ObjectID>
<a:Name>ErpCompetency</a:Name>
<a:Code>ErpCompetency</a:Code>
