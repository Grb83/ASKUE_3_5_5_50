<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A codified representation of the location.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o2399">
<a:ObjectID>2083635C-80B2-435A-B17C-6E95A19AC99A</a:ObjectID>
<a:Name>polygonFlag</a:Name>
<a:Code>polygonFlag</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Flag is true if the first and last point in the a sequence of coordinate pairs are to be connected, thus forming a polygon rather than merely a sequence of line segments.</a:Comment>
<a:DataType>boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
