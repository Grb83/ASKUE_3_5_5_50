						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "Property"
					quid       	"3AA805310226"
					documentation 	" Information about a particular piece of property such as its use.  Ownership of the property may be determined through associations to Organisations and/or ErpPersons. "
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"44A158200242"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
