<a:Code>TR_gate_event_message_span_event</a:Code>
<a:Text>CREATE TRIGGER TR_gate_event_message_span_event   ON gate_message   FOR DELETE   AS    DELETE FROM gate_event_message_span WHERE msg_id IN (SELECT msg_id FROM DELETED);
