						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "occupancyDate"
						quid       	"3AA805300348"
						documentation 	" Date certificate of occupancy was provided for this location.   Value is zero if a valid certificate of occupancy does not exists for this location Service location code."
						type       	"AbsoluteDate"
