						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "estLoad"
						quid       	"40D845F0002C"
						documentation 	
|Estimated load in amps.
|
|Note: This could be replaced in the future to identify a collection of loads and associated power factors
						
						type       	"integer"
						exportControl 	"Public")
					    (object ClassAttribute "billingCycle"
						quid       	"3AA8052D0366"
