				    (object Class "ElectricalProperties"
					quid       	"443F7AAD0261"
					documentation 	
|Used to define either the required electrical properties of a type of asset or the actual electrical properties of an asset model.  An ElectricalTypeAsset or ElectricalAssetModel may have multiple ElectricalProperties associated with it, with the ElecTAElecPropRole/ElecAMElecPropRole defining which roles in the Asset these properties refer to. e.g. a Transformer TypeAsset or AssetModel will have an ElectricalProperties association for each winding.
|
|This can also be used to define ElectricalProperties for each phase individually by using the phases attribute thus allowing an ElectricalTypeAsset or ElectricalAssetModel to have an individual entry for each phase.
|
|Not every property will be required for each typeof ElectricalTypeAsset. e.g. a Transformer may only have requirments for ratedKV, ratedMVA and phases, while a LinearConductor will have r,x,b and g requirements per unitLength on top of a ratedAmps and ratedKV.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"443F807F0119"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "r"
						quid       	"443F7D8A0167"
						documentation 	"Positive sequence series resistance"
						type       	"Resistance"
						quidu      	"350C6E0400F3"
						exportControl 	"Public")
					    (object ClassAttribute "x"
						quid       	"443F7D8E003E"
						documentation 	"Positive sequence series reactance"
						type       	"Reactance"
						quidu      	"350C6D01015F"
						exportControl 	"Public")
					    (object ClassAttribute "r0"
						quid       	"443F7D8E02EE"
						documentation 	"Zero sequence series resistance"
						type       	"Resistance"
						quidu      	"350C6E0400F3"
						exportControl 	"Public")
					    (object ClassAttribute "x0"
						quid       	"443F7D93005D"
						documentation 	"Zero sequence series reactance"
						type       	"Reactance"
						quidu      	"350C6D01015F"
						exportControl 	"Public")
					    (object ClassAttribute "b"
						quid       	"443F7D940177"
						documentation 	"Positive sequence susceptance"
						type       	"Susceptance"
						quidu      	"37A3A7630185"
						exportControl 	"Public")
					    (object ClassAttribute "b0"
						quid       	"443F7D96034B"
						documentation 	"Zero sequence susceptance"
						type       	"Susceptance"
						quidu      	"37A3A7630185"
						exportControl 	"Public")
					    (object ClassAttribute "g"
						quid       	"443F7DFF0148"
						documentation 	"Positive sequence conductance"
						type       	"Conductance"
						quidu      	"37A3A35E037A"
						exportControl 	"Public")
					    (object ClassAttribute "g0"
						quid       	"443F7E010157"
						documentation 	"Zero sequence conductance"
						type       	"Conductance"
						quidu      	"37A3A35E037A"
						exportControl 	"Public")
					    (object ClassAttribute "ratedKV"
						quid       	"443F7F8C035B"
						documentation 	"Rated voltage"
						type       	"Voltage"
						quidu      	"3503727C02EB"
						exportControl 	"Public")
					    (object ClassAttribute "ratedMVA"
						quid       	"443F7F8F0196"
						documentation 	"Rated Apparent Power"
						type       	"ApparentPower"
						quidu      	"350892520192"
						exportControl 	"Public")
					    (object ClassAttribute "phases"
						quid       	"443F83FE008C"
						documentation 	"Describes the phases carried, if applicable. Possible values { ABCN , ABC, ABN, ACN, BCN, AB, AC, BC, AN, BN, CN, A, B, C, N }."
						type       	"PhaseCode"
						quidu      	"372FD56E0255"
