<c:Classes>
<o:Class Id="o4309">
<a:ObjectID>6927DCD1-37FB-4C30-9D5C-3347AA65B023</a:ObjectID>
<a:Name>DesignLocationCU</a:Name>
<a:Code>DesignLocationCU</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment> Compatible Unit at a given design location.  </a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o4326">
<a:ObjectID>9DF12206-DC92-4D98-BF49-87C50ABA8B69</a:ObjectID>
<a:Name>cuQuantity</a:Name>
<a:Code>cuQuantity</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The quantity of the CU being assigned to this location.</a:Comment>
<a:DataType>Numeric</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o4327">
<a:ObjectID>AB5FF13A-3A42-4366-B763-60148D529D8F</a:ObjectID>
<a:Name>cuAction</a:Name>
<a:Code>cuAction</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A code that drives instructs the crew what action to perform.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o4328">
<a:ObjectID>C094203D-8DF1-4065-AA46-B012A5D6B433</a:ObjectID>
<a:Name>cuUsage</a:Name>
<a:Code>cuUsage</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>As the same CU can be used for different purposes and accounting purposes, usage must be specified.  Examples include: distribution, transmission, substation.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o4329">
<a:ObjectID>4AFCC042-6207-4BFF-81AD-388F5EAC508D</a:ObjectID>
<a:Name>cuAccount</a:Name>
<a:Code>cuAccount</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A code that helps direct accounting (capital, expense, or accounting treatment).</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o4330">
<a:ObjectID>1C75767D-698E-4CD1-B783-CF288A23A015</a:ObjectID>
<a:Name>energizationFlag</a:Name>
<a:Code>energizationFlag</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>True if associated electrical equipment is intended to be energized while work is being performed.</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o4331">
<a:ObjectID>2934F97E-DF42-417A-9E37-92FE5FD1C084</a:ObjectID>
<a:Name>yearRemoval</a:Name>
<a:Code>yearRemoval</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>This is the year when a CU that represents an asset is removed</a:Comment>
<a:DataType>AbsoluteDateTime</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o4306">
<a:ObjectID>A54B4B5E-781B-4A09-A2A3-B66069110C2D</a:ObjectID>
<a:Name>CompatibleUnit</a:Name>
<a:Code>CompatibleUnit</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment> A compatible unit is a pre-planned job model containing labor, material, and accounting requirements for standardized job planning.</a:Comment>
