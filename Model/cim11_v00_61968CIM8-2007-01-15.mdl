					quid       	"4505D6120251"
					supplier   	"Logical View::61968::GML_Support::GmlSymbol"
					quidu      	"4505CB020196")))
			    (object Class "GmlTextSymbol"
				quid       	"4505D5CD03A9"
				documentation 	"Used for styling text labels"
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4505D616035B"
