<o:Class Id="o8399">
<a:ObjectID>E9737910-6180-4F67-8769-02036828269F</a:ObjectID>
<a:Name>RampRateCurve</a:Name>
<a:Code>RampRateCurve</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Ramp rate as a function of resource MW output</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o8400">
<a:ObjectID>D9A6FD71-332F-44A7-81F1-407A13F28A6A</a:ObjectID>
<a:Name>rampRateType</a:Name>
<a:Code>rampRateType</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>How ramp rate is applied (e.g., raise or lower, as when applied to a generation resource)</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o7978">
<a:ObjectID>24241E68-2F38-4FD5-AF76-EA41AE3938A8</a:ObjectID>
<a:Name>ResourceBid</a:Name>
<a:Code>ResourceBid</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Energy bid for generation, load, or virtual type for the whole of the market-trading period (i.e., one day in day ahead market or one hour in the real time market)</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o8401">
<a:ObjectID>C9B8F1E4-3A4D-4DC7-B5F3-EC5FB621D3E3</a:ObjectID>
<a:Name>commodityType</a:Name>
<a:Code>commodityType</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Energy product (commodity) type:
 &#39;En&#39; - Energy
 &#39;Ru&#39; - Regulation Up
 &#39;Rd&#39; - Regulation Dn
 &#39;Sr&#39; - Spinning Reserve
 &#39;Nr&#39; - Non-Spinning Reserve
 &#39;Or&#39; - Operating Reserve
</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o8402">
<a:ObjectID>A2DCA436-2457-42F5-96B1-F787017BAB5F</a:ObjectID>
<a:Name>energyMinDay</a:Name>
<a:Code>energyMinDay</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Minimum amount of energy per day which has to be produced during the trading period in MWh</a:Comment>
<a:DataType>ActivePower</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o8403">
<a:ObjectID>C0AD054F-577B-40B1-B8A9-96B743DB7267</a:ObjectID>
<a:Name>energyMaxDay</a:Name>
<a:Code>energyMaxDay</a:Code>
