						name       	"NercAttrProfile"
						value      	TRUE)
					    (object Attribute
						tool       	"Cim"
						name       	"NercProfile"
						value      	TRUE))
					quid       	"3526913301AE"
					documentation 	"Maximum available capacitive reactive power"
					type       	"Reactance"
					quidu      	"350C6D01015F"
					exportControl 	"Public")
				    (object ClassAttribute "inductiveRating"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Cim"
						name       	"NercAttrProfile"
						value      	TRUE)
					    (object Attribute
						tool       	"Cim"
						name       	"NercProfile"
						value      	TRUE))
					quid       	"35269146029C"
					documentation 	"Maximum available inductive reactive power"
					type       	"Reactance"
					quidu      	"350C6D01015F"
					exportControl 	"Public")
				    (object ClassAttribute "sVCControlMode"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Cim"
						name       	"NercAttrProfile"
						value      	TRUE)
					    (object Attribute
						tool       	"Cim"
						name       	"NercProfile"
						value      	TRUE))
					quid       	"3526915B0396"
					documentation 	"SVC control mode: MVAr, Voltage"
					type       	"ControlMode"
					quidu      	"350897C000DC"
					exportControl 	"Public")
				    (object ClassAttribute "slope"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Cim"
						name       	"NercProfile"
						value      	TRUE))
					quid       	"3AB2861A0191"
					documentation 	"The characteristics slope of an SVC defines how the reactive power output changes in proportion to the difference between the regulated bus voltage and the voltage setpoint."
					type       	"VoltagePerReactivePower"
					quidu      	"415DB1060087"
					exportControl 	"Public")
				    (object ClassAttribute "voltageSetPoint"
					attributes 	(list Attribute_Set
					    (object Attribute
						tool       	"Cim"
						name       	"NercProfile"
						value      	TRUE))
					quid       	"3AB286D702E8"
					documentation 	"The reactive power output of the SVC is proportional to the difference between the voltage at the regulated bus and the voltage setpoint.  When the regulated bus voltage is equal to the voltage setpoint, the reactive power output is zero."
					type       	"Voltage"
					quidu      	"3503727C02EB"
					exportControl 	"Public"))
