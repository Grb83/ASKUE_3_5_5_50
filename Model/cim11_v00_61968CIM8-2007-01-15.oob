<o:Class Id="o2009">
<a:ObjectID>8EEEE2A1-5012-42D8-B948-32A39ECA1B9C</a:ObjectID>
<a:Name>WorkBillingInfo</a:Name>
<a:Code>WorkBillingInfo</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment> Billing information for work performed.  

The history of Work Billing Info, Invoices, and Payments is to be maintained in associated ActivityRecords.
</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
