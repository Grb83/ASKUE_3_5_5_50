			    (object Class "GmlPosition"
				quid       	"4461E36F02BF"
				documentation 	
|Position described by a single set of coordinates within a coordinate reference system.
|
|Note that a sequence of x/y coordinate pairs may be specified to provide the physical location of non-point oriented objects like Cables, Ducts, etc. or for describing an area of an object like a substation or georgraphical zone.  
|
				
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "xPosition"
					quid       	"4469C05B00DA"
					documentation 	"The position along the X axis of  the coordinate reference system."
					type       	"LongDouble"
					quidu      	"39DDF23C038F"
					exportControl 	"Public")
				    (object ClassAttribute "yPosition"
					quid       	"4469C05E037A"
					documentation 	"The position along the Y axis of  the coordinate reference system."
					type       	"LongDouble"
					quidu      	"39DDF23C038F"
					exportControl 	"Public")
				    (object ClassAttribute "sequenceNumber"
					quid       	"4469C0610290"
					documentation 	"The position of this position within a series of positions.  It is zero relative."
					type       	"Integer"
					quidu      	"40E514C202C2"
					initv      	"0"
					exportControl 	"Public")
				    (object ClassAttribute "zPosition"
					quid       	"446A1B0003B9"
					documentation 	"If applicable,the position along the Z axis of  the coordinate reference system."
					type       	"LongDouble"
					quidu      	"39DDF23C038F"
					exportControl 	"Public")))
