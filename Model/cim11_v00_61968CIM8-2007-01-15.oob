<c:Classes>
<o:Class Id="o1480">
<a:ObjectID>D73B5F07-018D-469F-A76E-C30AF2C6133D</a:ObjectID>
<a:Name>AssetContainer</a:Name>
<a:Code>AssetContainer</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>An asset that is an aggregation of other assets such as a  conductors, transformers, switchgear, land, fences, buildings, equipment, vehicles, etc.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
</o:Class>
<o:Class Id="o1489">
<a:ObjectID>EC0DF72D-EAE8-45E2-9149-57E7DED940A8</a:ObjectID>
<a:Name>SubstationAsset</a:Name>
<a:Code>SubstationAsset</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A grouping of assets such as conductors, transformers, switchgear, etc..  When located on the ground surface, it is usually surrounded by some kine of fence with a locked gate.  It may also be located inside buildings, in underground vaults, and on structures.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o1500">
<a:ObjectID>003D212A-BD14-46AB-989C-074FA86C5191</a:ObjectID>
<a:Name>typeSubstation</a:Name>
<a:Code>typeSubstation</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The type of substation such as Air Cooled, Gas Insultated.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o1501">
<a:ObjectID>B3EDB6C1-9F56-46E6-AFA5-424B8CE4474F</a:ObjectID>
<a:Name>subClass</a:Name>
<a:Code>subClass</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Classification of the substation such as transmission, sub-transmission, distribution, customer.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o1485">
<a:ObjectID>0D970E32-86A7-453A-8063-89C192FEBAF2</a:ObjectID>
<a:Name>Cabinet</a:Name>
<a:Code>Cabinet</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Cabinets are enclosures that offer protection to the equipment they contain and/or safety to people/animals outside the cabinet.   </a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
