					type       	"Money"
					quidu      	"350C644500EB"
					exportControl 	"Public")))
			    (object Class "CustomerList"
				quid       	"3AA804F60154"
				documentation 	" Generic part of a document containing references to many Customers. Could be list of connected customers or list of affected customers."
				superclasses 	(list inheritance_relationship_list
