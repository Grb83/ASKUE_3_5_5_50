<o:Class Id="o6455">
<a:ObjectID>3B659FD5-6781-4886-89B8-1F3112665057</a:ObjectID>
<a:Name>ClearanceTag</a:Name>
<a:Code>ClearanceTag</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A clearance tag that is used to authorize and schedule work on conducting equipment in the field. Tagged equipment is not available for commercial service.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o6465">
<a:ObjectID>F28BE712-5F39-4290-9B10-79E8DA8A05D4</a:ObjectID>
<a:Name>authorityName</a:Name>
<a:Code>authorityName</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The name of the person who is authorized to issue the tag</a:Comment>
<a:DataType>Name</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o6466">
<a:ObjectID>24D3EF2C-BB62-405E-B4F8-93FAEA6F0676</a:ObjectID>
<a:Name>clearanceTagType</a:Name>
<a:Code>clearanceTagType</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The type of tag, depending on the purpose of the work to be performed and/or the type of supervisory control allowed.</a:Comment>
<a:DataType>ClearanceTagType</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o6467">
<a:ObjectID>A9587A34-6F63-48C2-815A-46F7F78445AE</a:ObjectID>
