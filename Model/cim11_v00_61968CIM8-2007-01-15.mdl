			    (object Class_Category "Outages"
				quid       	"3AA805AC035C"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "OutageRecord"
					quid       	"3AA805B602B2"
					documentation 	
| A document describing details of an outage in part of the electrical network. Typically produced  by a SCADA system following a breaker trip or within a Trouble Call System by grouping customer calls. This has an associated OutageStep for each supply point.
|
|In some countries all outage restoration is performed using a SwitchingSchedule which complements the OutageRecord and records the ErpPersons (crew) and any planned Work. In other systems, it may be acceptable to manage outages including new WorkTasks without switching schedules.
|Note: The relationship between OutageRecord and ErpPerson and Crew is inherited as each is a type of Document.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CDFAD0370"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "outageType"
						quid       	"3AA805B6035C"
						documentation 	" Type of outage, often express as a cause code.  While many cause codes may be applicable to a given outage, the primary cause in captured here."
						type       	"EnumeratedType"
						exportControl 	"Public")
					    (object ClassAttribute "endDateTime"
						quid       	"3AA805B700BE"
						documentation 	"Time restoration was completed for all customers impacted by this outage."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "isPlanned"
						quid       	"3AA805B8033E"
						documentation 	" false if unplanned, for example due to a breaker trip."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "startDateTime"
						quid       	"3D29B51E0317"
						documentation 	" date and time first customer went off-supply"
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "currentStatus"
						quid       	"3D29B53700EC"
						documentation 	"Current status of the overall outage.  Note that each status change is recorded in an associated Activity Record."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "actionTaken"
						quid       	"3D2B47290311"
						documentation 	"Overall action taken to resolve outage.  Reference associated work tasks for details."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "damageCode"
						quid       	"3D2B47DF01AE"
						documentation 	"The damage code relative to the associated PowerSystemResource(s) and/or Asset(s). Examples include broken, burnout, failure, flashed (burned), manually operated, wire down, no damage - rolling blackout, none. "
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "mode"
						quid       	"3D2B5AB902A4"
						documentation 	"The value of Organisation.mode at the time of OutageRecord.startDateTime.  Some utilities use text to describe various modes like nominal, storm, emergency, other.  Other utilities use severity ratings where, for example, 0 is a nominal condition and 5 is the most severe condition.  This information is often required for outage reporting purposes."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "OutageReport"
					quid       	"3AA805BA00D2"
					documentation 	" A document describing the statistics related to an outage."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CF5E5001E"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "totalCustomers"
						quid       	"3AA805BA02F8"
						documentation 	" Number of customers for the Outage Record"
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "totalDuration"
						quid       	"3AA805BB005A"
						documentation 	" Total outage time."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "aveCustomerMinsLost"
						quid       	"3BC59ACC02D0"
						documentation 	"The average cusotmer minutes of interruption for this outage."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "totalCustomerMinsLost"
						quid       	"3AA805BB01A4"
						documentation 	"Total minutes of customer interruption."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")))
				    (object Class "OutageStep"
					quid       	"3AA805BB0320"
					documentation 	"Holds an Outage History (start time, end time) for each supply point of an outage record.   The supply point for a given step is the associated PowerSystemResource instance."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3D223E050082"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "offDateTime"
						quid       	"3AA805BB03C0"
						documentation 	"Time power was lost."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "onDateTime"
						quid       	"3AA805BC0122"
						documentation 	"Time power was restored."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "jobPriority"
						quid       	"3AA805BC026C"
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "numberTotalCustomers"
						quid       	"3AA805BC03B6"
						documentation 	" Number of customers connected to the PowerSystemResource."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "numberSpecialCustomers"
						quid       	"3AA805BD0118"
						documentation 	" Number of customers with high reliability required."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "numberCriticalCustomers"
						quid       	"3AA805BD029E"
						documentation 	" Number of customers with critical needs, e.g.,  with a dialysis machine."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "numberCallers"
						quid       	"3AA805BE006E"
						documentation 	" number of customers phoning in"
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "fatality"
						quid       	"3AA805BE0226"
						documentation 	" Fatalities reported by caller or engineer? Y/N/Null"
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "injury"
						quid       	"3AA805BF0028"
						documentation 	" Injuries reported by caller or engineer? Y/N/Null"
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "shocks"
						quid       	"3AA805BF01A4"
						documentation 	" Shocks reported by caller or engineer? Y/N/Null"
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "damage"
						quid       	"3AA805BF02EE"
						documentation 	" Damage reported by caller or engineer? Y/N/Null"
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "estRestoreDateTime"
						quid       	"3BC599F702D0"
						documentation 	"Estimated time of restoration."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "averageCustMinIntrpt"
						quid       	"3BC59B4C035C"
						documentation 	"The average cusotmer minutes of interruption for this supply point for this outage."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "customerMinutesLost"
						quid       	"3BC59B520276"
						documentation 	"Total minutes of customer interruption for this supply point for this outage."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "currentStatus"
						quid       	"3D2A221F0292"
						documentation 	"Current status of this outage step. "
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "OutageCode"
					quid       	"3D2B3B3C03D9"
					documentation 	
|Classification of outage types.  Multiple outage codes may apply to a given a given outage or outage step.  The primary overall outage type is recorded in OutageRecord.outageType.  There may be more than one classification per outage step and/or per outage record.
|
|Example codes/subcodes include: weather/ice, weather/lightning, wildlife/squirrel, wildlife/bird, burned/overload, burned/weather, wire down/accident, wire down/tree, wire down/vandalism, etc.
|
|The typical "outage code" is in the inherited "name" attribute.  The code is described in the inherited "description" attribute. 
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3D2B41E401C0"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "subCode"
						quid       	"3D2B3BE90038"
						documentation 	"The main code is stored in the inherited .name.  This sub-code provides an additional level of classification detail."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "OutageStepPsrRole"
					quid       	"3D9CB1D901B2"
					documentation 	"Roles played between Power System Resources and Outage Steps.  Examples roles include: normal supply, actual supply, interrupting device, restoration device."
