						exportControl 	"Public")))
				    (object Class "Location"
					quid       	"3AA80517019A"
					documentation 	"The place, scene, or point of something  where someone or something has been, is, and/or will be at a given moment in time.  It may be the spatial location of an actual or planned structure or set of point-oriented structures (as a substation, structure, building, town, etc.), which may be defined as a point or polygon.  It may also be the path of a underground or overhead conductor. "
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CC72C0384"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "locationType"
						quid       	"3CB60AD603C7"
						documentation 	"The type of location: geographical, functional accounting, other."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "locationCode"
						quid       	"3CB6172801B2"
						documentation 	"A codified representation of the location."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "polygonFlag"
						quid       	"3F719D44002E"
						documentation 	"Flag is true if the first and last point in the a sequence of coordinate pairs are to be connected, thus forming a polygon rather than merely a sequence of line segments."
						type       	"boolean"
						exportControl 	"Public")))
				    (object Class "LocationGrant"
					quid       	"3AA8051C0276"
					documentation 	" A grant provides a right, as defined by type, for a parcel of land.  Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"441E991E004E"
						supplier   	"Logical View::61968::Core2::TopLevel::Agreement"
						quidu      	"35036BB4029F"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "grantType"
						quid       	"3AA8051D0078"
