		    (object Class_Category "Assets"
			quid       	"3AA80450019A"
			documentation 	"This package is used to define asset-level models for objects. Assets may be comprised of other assets and may have relationships to other assets. Assets also have owners and values. Assets may also have a relationship to a PowerSystemResource in the Wires model."
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "AssetsVersion"
				quid       	"4509A38D031C"
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "version"
					quid       	"4509A3B6029F"
					initv      	"Assets_v008")
				    (object ClassAttribute "date"
					quid       	"4509A412008C"
					initv      	"2006-09-15")))
			    (object Class_Category "AssetBasics"
				quid       	"3AE5D88701A0"
				documentation 	"Asset basics package; it is the top level of asset hierarchy."
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "Asset"
					quid       	"3AA8045102DA"
					documentation 	" A tangible resource of the utility, including power system equipment, cabinets, buildings, etc.  For electrical network equipment, the role of the asset is defined in the Wires Model (refer to IEC 61970-301).  This role is associated with an asset description, which places emphasis on the  physical characteristics of the equipment fulfilling that role.  This is the parent class for asset sub classes."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B8F9BC60334"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "code"
						quid       	"3AA804520118"
						documentation 	" Code for this type of asset."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "utc"
						quid       	"3AA804520262"
						documentation 	" Uniquely Tracked Commodity (UTC) number."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "serialNumber"
						quid       	"3AA804530140"
						documentation 	" Serial number of asset."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "assetType"
						quid       	"3AA8045303D4"
						documentation 	" General classification for this for this type of asset.  Note that specializations of TypeAsset have a type that is intended to be unique to that type of asset, which can be enumerated for that type of asset in accordance with a utility's standards."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "manufacturedDate"
						quid       	"3AA804540136"
						documentation 	" Data asset was manufactured."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "critical"
						quid       	"3AA804590280"
						documentation 	" True if asset is considered critical for some reason.  For example, a pole with critical attachments."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "condition"
						quid       	"3AA8045B026C"
						documentation 	" Condition of asset in inventory or at time of installation.  Examples include new, rebuilt, overhaul required, other.  Refer to inspection data for information on the most current condition of the asset."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "assetUsage"
						quid       	"3AA8045D00D2"
						documentation 	" Asset usage.  Examples include: Distribution Overhead, Distribution Underground, Transmission, Substation, Streetlight, Customer Substation, Unknown, Other."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "purchasePrice"
						quid       	"3AA8045D0366"
						documentation 	" Purchase price (amount, units) of asset."
						type       	"Money"
						quidu      	"350C644500EB"
						exportControl 	"Public")
					    (object ClassAttribute "testStatus"
						quid       	"3C89ECC30280"
						documentation 	"True  if asset has passed acceptance test and may be placed in or is in service.  It is returned to a false state if asset is removed from service and is required to be tested again before being placed back in service, possibly in a new location. The date of each acceptance test (device may go through multiple test during its life cycle) is determined in AssetStatus."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "statusDate"
						quid       	"3D4EC97900DF"
						documentation 	"Date status of association was entered."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "currentStatus"
						quid       	"3D4EC9830379"
						documentation 	
|Status at the time of "statusDate."  Asset is new construction (installed, ready to be placed in operation), in-service, decommissioned (out-of-service), removed, existing, proposed abandoned, proposed install, proposed remove, proposed replace, unknown, other.
|
|For history of status changes, refer to assoicated activity records.
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "lotNumber"
						quid       	"3F7CB2240175"
						documentation 	"Even for the same model and version number, many assets are manufactured in lots.  the lotNumber identifies the specific lot for this asset."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "installationDate"
						quid       	"41DC65F1023A"
						documentation 	"Date current installation was completed, which may not be the same as the in-service date.  Asset may have been installed at other locations previously.  Value is null if asset is (1) not currently installed (e.g., stored in a depot) or (2) not intended to be installed (e.g., vehicle, tool)."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "phases"
						quid       	"41DEB86A00B1"
						documentation 	
|"As built" phase or phases that the asset is associatied with.  "N/A" is the value when not applicable. "N/S is the value for a phase oriented device that is not in service (not connected to a phase or phases). 
|Possible values { ABCN , ABC, ABN, ACN, BCN, AB, AC, BC, AN, BN, CN, A, B, C, N, N/A, N/S }.
						
						type       	"PhaseCode"
						quidu      	"372FD56E0255"
						initv      	
|"N/S"
						
						exportControl 	"Public")
					    (object ClassAttribute "application"
						quid       	"41DEBA6A02FC"
						documentation 	"The way this particular asset is being used in this installation.  For example, the application of a bushing when attached to a specific transformer winding would be one of the following: H1, H2, H3, H0, X1, X2, X3, X0, Y1, Y2, Y3, Y0."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "initialLossOfLife"
						quid       	"41EC414203C9"
						documentation 	"Zero for new devices.  Whenver an asset is reconditioned, this is the percentage off expected life for the asset when it was new."
						type       	"PerCent"
						quidu      	"3503720600E3"
						exportControl 	"Public")))
