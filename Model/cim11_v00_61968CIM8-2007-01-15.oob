<a:Modifier>sechin</a:Modifier>
<a:Comment> Emergency low voltage limit (p.u. V)</a:Comment>
<a:DataType>Float</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o2049">
<a:ObjectID>F209BAB1-D9F6-4FA0-AC88-7BBDDE95B5AB</a:ObjectID>
<a:Name>valueUninterruptedServiceKW</a:Name>
<a:Code>valueUninterruptedServiceKW</a:Code>
