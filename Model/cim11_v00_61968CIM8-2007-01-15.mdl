			    (object ClassAttribute "defaultIntegrationMethod"
				quid       	"35268CFB0093"
				documentation 	"The default method by which interchange schedules are to be integrated to obtain hourly MWh schedules for accounting. Method #1 is to integrate the instantaneous schedule between the hourly boundaries. Method #2 compensates for any up/down ramping that occurs across the hourly boundary (this is called block accounting)."
				type       	"EnumeratedType"
				exportControl 	"Public"))
