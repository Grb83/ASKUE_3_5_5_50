			    (object Class_Category "Presentation"
				quid       	"3F6B2DCA03E7"
				documentation 	
|In addition to providing physical location information, real world objects of the CIM may also be represented on various types of displays, diagrams, maps, etc. through the concept of a diagram object, which is a specialization of Location.  Note that a manner for accomplishing this is elaborated on in the "GML Support" package.
				
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "Diagram"
					quid       	"3F6B38E101E0"
					documentation 	
|GML and/or other means are used for rendering objects on various types (geographic, schematic, other) of displays and maps associated with various coordinate systems.
|
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"4509D51D0196"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "diagramType"
						quid       	"451BCC3D02AF"
						documentation 	"The type of diagram, for example, schematic, geographic, internal view (e.g., inside a vault or cabinet), design sketch, etc."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "PresentationVersion"
					quid       	"4509AB5303A9"
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "version"
						quid       	"4509AB62001F"
						initv      	"Presentation_v008")
					    (object ClassAttribute "date"
						quid       	"4509AB650251"
						initv      	"2006-09-15")))
				    (object Class "Map"
					quid       	"44615B32000F"
					documentation 	"A Map is a type of diagram that is usually printed on paper.  It normally depicts part of the earth's surface, showing utility assets, right of ways, topological data, coordinates, grids, etc.  Maps vary depending on wether they are used for dispatch, design, schematic, etc."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"44615B530203"
						supplier   	"Logical View::61968::Core2::Presentation::Diagram"
						quidu      	"3F6B38E101E0"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "mapType"
						quid       	"4461CE8801D4"
						documentation 	" Type of map."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "mapLocPage"
						quid       	"4461CE95003E"
						documentation 	"Page number for particular set of maps specified by mapType."
