		    (object Class_Category "LoadModel"
			quid       	"35B68E9702DE"
			documentation 	
|This package is responsible for modeling the energy consumers and the system load as curves and associated curve data. Special circumstances that may affect the load, such as seasons and daytypes, are also included here.
|
|This information is used by Load Forecasting and Load Management.
			
			visible_categories 	(list visibility_relationship_list
			    (object Visibility_Relationship
				quid       	"35B68ECC032C"
				supplier   	"Logical View::61970::Wires"
				quidu      	"35031AD100EB"))
			exportControl 	"Public"
			subsystem  	"Component View::LoadModel"
			quidu      	"3752FD860195"
			logical_models 	(list unit_reference_list
			    (object Class "AreaLoadCurve"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Cim"
					name       	"NercProfile"
					value      	TRUE)
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"351571CB033E"
				documentation 	
|A curve relating  power versus time. showing the values of a specific load for each unit of the period covered. The  curve can be based on "absolute" time or on "normalized' time. An instance of this curve could represent the absolute area load forecast. An other instance could represent a normalized daily load curve for a particular day type.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"44C8DD820314"
					supplier   	"Logical View::61970::Core::RegularIntervalSchedule"
					quidu      	"4472D403038D"))
				module     	"Component View::LoadModel::AreaLoadCurve (module spec)"
				quidu      	"3752FD86028E"
				language   	"Java")
			    (object Class "AreaLossCurve"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"351571F303D4"
				documentation 	"The relationship between total area MW losses (Y-axis) and total area MW load (X-axis)"
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"352D78280154"
					supplier   	"Logical View::61970::Core::Curve"
					quidu      	"35157A060078"))
				module     	"Component View::LoadModel::AreaLossCurve (module spec)"
				quidu      	"3752FD86028F"
				language   	"Java")
			    (object Class "CustomerLoad"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Cim"
					name       	"NercClassProfile"
					value      	TRUE)
				    (object Attribute
					tool       	"Cim"
					name       	"NercProfile"
					value      	TRUE))
				quid       	"35157A39038E"
				documentation 	"A meter for measuring customer energy consumption. The typeName attribute indicates the type of customer meter."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"352F76A0009C"
					supplier   	"Logical View::61970::Wires::EnergyConsumer"
					quidu      	"35157BB5033E"))
				module     	"Component View::LoadModel::CustomerMeter (module spec)"
				quidu      	"3752FD860293"
				language   	"Java")
			    (object Class "DayType"
