<o:Class Id="o8811">
<a:ObjectID>5E1F60D7-52BF-41D6-BD30-CF64B625ADA8</a:ObjectID>
<a:Name>DynamicSchedule</a:Name>
<a:Code>DynamicSchedule</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A continuously variable component of a control area&#39;s MW net interchange schedule. Dynamic schedules are sent and received by control areas.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o8827">
<a:ObjectID>2BF8E697-299F-43B3-9422-6FE89B580979</a:ObjectID>
<a:Name>dynSchedSignRev</a:Name>
<a:Code>dynSchedSignRev</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Dynamic schedule sign reversal required (yes/no)</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o8828">
<a:ObjectID>C99E06EB-9A70-4208-A28A-7375997E0926</a:ObjectID>
<a:Name>dynSchedStatus</a:Name>
<a:Code>dynSchedStatus</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The &quot;active&quot; or &quot;inactive&quot; status of the dynamic schedule
</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o8809">
<a:ObjectID>09D86C2C-8DC5-4D9F-82A9-FE9BA037A9A9</a:ObjectID>
<a:Name>EnergyTransaction</a:Name>
<a:Code>EnergyTransaction</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Specifies the schedule for energy transfers between interchange areas that are necessary to satisfy the associated interchange transaction.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o8829">
<a:ObjectID>01B38D50-2D58-4175-A346-A5D12C43A194</a:ObjectID>
<a:Name>firmInterchangeFlag</a:Name>
<a:Code>firmInterchangeFlag</a:Code>
