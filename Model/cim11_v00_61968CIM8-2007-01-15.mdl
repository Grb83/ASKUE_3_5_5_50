			    (object Class_Category "TopLevel"
				quid       	"3AA8053501FE"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "Organisation"
					quid       	"3AA8054101AE"
					documentation 	" This class is used to identify organisations that might have roles as utilities, contractors, suppliers, manufacturers, customers, etc. Organisations may also have parent-child relationships to identify departments within an organisation, or parent company relationships."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CC163003C"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "organisationCode"
						quid       	"3AA80543023A"
						documentation 	" Designated code for organisation."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "currentStatus"
						quid       	"3B20EC85012C"
						documentation 	"Status of this organisation (e.g., planned, open, closed, other)."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "statusDate"
						quid       	"3B20ECD303B6"
						documentation 	"Date status of association was entered."
						type       	"AbsoluteDate"
						exportControl 	"Public")
					    (object ClassAttribute "organisationType"
						quid       	"3CB619FB0256"
						documentation 	
|The type of organisation.  Examples include utility customer, utility enterprise, division, business unit, department, energry service supplier, energy service scheduler, independent system operator (ISO), regional transmission operator (RTO), manufacturer, contractor, governmental agency, tax authority, supplier, etc.
|Further information is available through the Standard Industrial Code (SIC) and marketRole.  
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "costCenterFlag"
						quid       	"3CB61AB903D0"
						documentation 	"Flag is true if organisation is a cost center."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "profitCenterFlag"
						quid       	"3CB61AC40322"
						documentation 	"Flag is true if organisation is a profit center.l"
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "mode"
						quid       	"3D2B58F50223"
						documentation 	"The operational mode of the organisation.  Some utilities use text to describe various modes like nominal, emergency, storm, other.  Other utilities use severity ratings where, for example, 0 is a nominal condition and 5 is the most severe condition.  This information is often required for outage reporting purposes."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "marketRole"
						quid       	"3B2A6C3501C2"
						documentation 	
|Role of market participant.  Examples include one or more of the following: Energy Service Consumer, Generator Owner, Generator Operator, Transmission Service Provider, Transmission Owner, Transmission Operator, Distribution Provider, Load Serving Entitie, Purchasing-Selling Entitie, Reliability Authority, Planning Authority, Balancing Authority, Interchange Authority, Transmission Planner, Resource Planner, Standards Developer, Compliance Monitor, and Not Applicable.
|
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "optOut"
						quid       	"3C6A97AB032A"
						documentation 	
|This field indicates whether or not the organisation has requested that their contact information not be shared with other organisations for purposes of solicitation, often referred to as "opting out."   false  = okay to solicit; true  = opted out.
						
						type       	"boolean"
						initv      	
|"false"
						
						exportControl 	"Public")
					    (object ClassAttribute "governmentID"
						quid       	"4106F0E9019B"
						documentation 	"Unique identifier for organisation relative to it's governing authority, for example a federal tax identifier."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "OrgErpPersonRole"
					quid       	"3AA80547038E"
					documentation 	"Roles played between Persons and Organisations."
