<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The type of location: geographical, functional accounting, other.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o2398">
<a:ObjectID>AD3DE8AA-387F-48AA-B58B-F097AA819526</a:ObjectID>
