			    (object Class_Category "WorkInitiation"
				quid       	"3AA806160398"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "Work"
					quid       	"3AA80636030C"
					documentation 	
| Work is a document which is used to request, initiate, track and record work. 
|
|This is synonymous with Work Breakdown Structure (WBS), which is traversed through the recursive association of Work.  
|Note that the work name is equal to the WBS name, which is given in the inherited "name" attribute.  At the sub-work level (through recursion), the inherited "type" attribute indicates whether the work is capital, operations and maintenance, or other.  
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B1FD31C02B2"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "workPriority"
						quid       	"3BB9826F008C"
						documentation 	" Priority of the work."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "requestDate"
						quid       	"3C90F14F02B2"
						documentation 	" Date work was requested."
						type       	"AbsoluteDate"
						exportControl 	"Public")
					    (object ClassAttribute "typeWork"
						quid       	"3D08FF0302BE"
						documentation 	"Type of work: construction, inspection, maintenance, service, misc. "
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "Project"
					quid       	"3BB9E56A0212"
					documentation 	
|A collection of related work.  For construction projects and maintenance projects,  multiple phases may be performed.
|
|
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3CB5CA0C00EB"
