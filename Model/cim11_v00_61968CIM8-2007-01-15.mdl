						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "loadControl"
						quid       	"427FD717035B"
						documentation 	"TRUE when the hardware is present to support load control functions through either the meter or the AMR option."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "reverseFlowHandling"
						quid       	"427FD7470222"
