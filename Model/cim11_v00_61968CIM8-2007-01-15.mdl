				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "label"
					quid       	"4506E0CC004E"
					documentation 	"Used to provide text-label content. If a Label value is not provided, then no text will be rendered."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "labelType"
					quid       	"4506E0D501B5"
					documentation 	"The type-classification of a label. The Label element is used to provide text-label content."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "minFontSize"
					quid       	"4507C4C703D8"
					documentation 	" The minimum font size allowed."
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "property"
					quid       	"4507C4F6005D"
					documentation 	
|A "TextSymbol" is used to render text labels according to various graphical parameters. "Property" provides a generic method for capturing all unspecified information pertaining to the TextSymbol.
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "fieldID"
					quid       	"4507C56600CB"
					documentation 	"The name of the field of the class being annotated.  Most objects will include name, description, and aliasName.  Many objects may contain other fields such as comment, status, etc."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "GmlPointSymbol"
				quid       	"4505D5DB0261"
				documentation 	
|A PointSymbol is used to draw a "graphic" at a point.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4505D61B01B5"
					supplier   	"Logical View::61968::GML_Support::GmlSymbol"
					quidu      	"4505CB020196")))
			    (object Class "GmlRasterSymbol"
				quid       	"4505D5EC0109"
				documentation 	"Describes how to render raster/matrix-coverage data (e.g., satellite photos, DEMs)."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4505D61F03A9"
					supplier   	"Logical View::61968::GML_Support::GmlSymbol"
					quidu      	"4505CB020196"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "opacity"
					quid       	"4506E10B02FD"
					documentation 	
|Specifies the level of translucency to use when rendering the Graphic.The value is encoded as a floating-point value
|between 0.0 and 1.0 with 0.0 representing completely transparent and 1.0 representing completely opaque, with a linear scale of translucency for intermediate values. The default value is 1.0
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "overlapbehaviour"
					quid       	"4506E119038A"
					documentation 	"Tells a system how to behave when multiple raster images in a layer overlap each other, for example with  satellite-image scenes."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "redSourcename"
					quid       	"4506E12501D4"
					documentation 	"Colour Channels are identified by a system and data-dependent character identifier. Contrast enhancement may be applied to each channel in isolation. "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "greenSourceName"
					quid       	"4506E15B037A"
					documentation 	"Colour Channels are identified by a system and data-dependent character identifier. Contrast enhancement may be applied to each channel in isolation. "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "blueSourcename"
					quid       	"4506E1630242"
					documentation 	"Colour Channels are identified by a system and data-dependent character identifier. Contrast enhancement may be applied to each channel in isolation. "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "graySourcename"
					quid       	"4506E1700222"
					documentation 	"A single colour channel may be selected to display in grayscale. Colour Channels are identified by a system and data-dependent character identifier. Contrast enhancement may be applied to each channel in isolation. "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "brighnessOnly"
					quid       	"4506E1DB029F"
					documentation 	"If the BrightnessOnly flag is 0 (false, default), the shading is applied to the layer being rendered as the current RasterSymbol. If BrightnessOnly is 1 (true), the shading is applied to the brightness of the colors in the rendering canvas generated so far by other layers, with the effect of relief-shading these other layers. "
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "reliefFactor"
					quid       	"4506E1E700DA"
					documentation 	
|The ReliefFactor gives the amount of exaggeration to use for the height of the "hills". A value of around 55 (times) gives reasonable results for Earth-based DEMs. The default value is system-dependent.
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "GmlStroke"
				quid       	"4505D6410128"
				documentation 	"The Stroke element encapsulates the graphical symbolization parameters for linear geometries."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4506DE7D0203"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "opacity"
					quid       	"4506DAC4005D"
					documentation 	
|Specifies the level of translucency to use when rendering the stroke. The value is encoded as a floating-point value
|between 0.0 and 1.0 with 0.0 representing completely transparent and 1.0 representing completely opaque, with a linear scale of translucency for intermediate values. The default value is 1.0
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "width"
					quid       	"4506DAD60280"
					documentation 	"The absolute width (thickness) of a stroke in pixels encoded as a float. The default is 1.0. Fractional numbers are allowed (with a system-dependent interpretation) but negative numbers are not."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "linejoin"
					quid       	"4506DADE03B9"
					documentation 	
|Enumerated values telling how line strings should be joined (between line segments). The values are represented as content strings.
|
|The allowed values for line join are "mitre", "round", and "bevel". The default values are system-dependent.
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "lineCap"
					quid       	"4506DAE701D4"
					documentation 	
|Enumerated values telling how line strings should be capped (at the two ends of the line string). The values are represented as content strings.
|
|The allowed values for line cap are "butt", "round", and "square". The default values are system-dependent.
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "lineStyle"
					quid       	"4507AB6202EE"
					documentation 	"The name of a defined line style. Usually will be an enumerated value and will be system-specific."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "dashArray"
					quid       	"4506E00103B9"
					documentation 	"Encodes a dash pattern as a series of space separated floats. The first number gives the length in pixels of dash to draw, the second gives the amount of space to leave, and this pattern repeats. If an odd number of values is given, then the pattern is expanded by repeating it twice to give an even number of values. Decimal values have a system-dependent interpretation (usually depending on whether antialiasing is being used). The default is to draw an unbroken line."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "dashOffset"
					quid       	"4506E00D0271"
					documentation 	
|Specifies the distance as a float into the "stroke-dasharray" pattern at which to start drawing.
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "GmlFill"
				quid       	"4505D64D0109"
				documentation 	"Specifies how the area of the geometry will be filled."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4506DE830203"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "opacity"
					quid       	"4506E0490167"
					documentation 	
|Specifies the level of translucency to use when rendering the Fill. The value is encoded as a floating-point value
|between 0.0 and 1.0 with 0.0 representing completely transparent and 1.0 representing completely opaque, with a linear scale of translucency for intermediate values. The default value is 1.0
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")))
			    (object Class "GmlHalo"
				quid       	"4505D657034B"
				documentation 	"A Halo is a type of Fill that is applied to the backgrounds of font glyphs. The use of halos greatly improves the readability of text labels."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4506DE940177"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
