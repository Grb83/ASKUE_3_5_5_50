<a:Name>FK_device_dev_def_id_delete_set_null</a:Name>
<a:Code>FK_device_dev_def_id_delete_set_null</a:Code>
<a:Text>CREATE TRIGGER FK_device_dev_def_id_delete_set_null   ON device_def   FOR DELETE   AS    UPDATE device SET dev_def_id = NULL    WHERE dev_def_id IN (SELECT dev_def_id FROM DELETED);
go</a:Text>
