				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "radius"
					quid       	"4506DF85032C"
					documentation 	"The Radius element gives the absolute size of a halo radius in pixels encoded as a floating-point number. The radius is taken from the outside edge of a font glyph to extend the area of coverage of the glyph (and the inside edge of “holes” in the glyphs). The default radius is one pixel. Negative values are not allowed."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "opacity"
					quid       	"4507FBC10148"
					documentation 	
|Specifies the level of translucency to use when rendering the Fill. The value is encoded as a floating-point value
|between 0.0 and 1.0 with 0.0 representing completely transparent and 1.0 representing completely opaque, with a linear scale of translucency for intermediate values. The default value is 1.0
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")))
			    (object Class "GmlFont"
				quid       	"4505D660031C"
				documentation 	"Identifies a font of a certain family, style, and size."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4506DEB401B5"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "family"
					quid       	"4506DE38031C"
					documentation 	"Gives the family name of a font to use. Allowed values are system-dependent. Any number of font-family attributes may be given and they are assumed to be in preferred order."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "style"
					quid       	"4506DE460232"
					documentation 	
|The style to use for a font. The allowed values are "normal", "italic", and "oblique".
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "weight"
					quid       	"4506DE4B0213"
					documentation 	
|The amount of weight or boldness to use for a font. Allowed values are "normal" and "bold".
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "size"
					quid       	"4506DE4F02BF"
					documentation 	"The size to use for the font in pixels. The default is defined to be 10 pixels, though various systems may have restrictions on what sizes are available."
					type       	"String"
					quidu      	"40E534EE0080"
