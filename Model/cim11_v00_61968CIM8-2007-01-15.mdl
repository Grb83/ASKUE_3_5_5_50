						quidu      	"3AA80681005A")))
				    (object Class "ComplianceEvent"
					quid       	"40D82A2103A1"
					documentation 	
|Compliance events are used for reporting regulatory or contract compliance issues and/or variances.  These might be created as a consequence of local business processes and associated rules. 
|
|Note: it is anticipated that this class will be customised extensively to meet local implementation needs.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"40D82A2F010C"
						supplier   	"Logical View::61968::Core2::ActivityRecords::ActivityRecord"
						quidu      	"3AA804D30384"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "complianceType"
						quid       	"40D82AA000E6"
						documentation 	"Type of compliance event indicating, for example, types of regulatory and/or contractual compliance events where expected performance will not be met or reported as mandated."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "deadline"
						quid       	"40D82C1403B2"
						documentation 	"The deadline for compliance."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")))
				    (object Class "OutageType"
					quid       	"414F3DCD036A"
					documentation 	
|This is an Enumeration type of class which is used to represent different type of outages.
|
|The following enumerations are provided:
|
|Fixed: the outage can not be rescheduled before actual start date is assigned
|Flexible: the outage can be rescheduled
|Forced: unforeseen interruption in equipment service
|
|
					
					stereotype 	"Enumeration"
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "Fixed"
						quid       	"414F3F7601EF"
						documentation 	"the outage can not be rescheduled before actual start date is assigned"
						exportControl 	"Public")
					    (object ClassAttribute "Flexible"
						quid       	"414F3F8200FC"
						documentation 	"the outage can be rescheduled"
						exportControl 	"Public")
					    (object ClassAttribute "Forced"
						quid       	"414F3F8A0003"
						documentation 	"unforeseen interruption in equipment service"
						exportControl 	"Public")))
