		    (object Class_Category "SCADA"
			quid       	"35031AF80097"
			documentation 	
|Contains entities to model information used by Supervisory Control and Data Acquisition (SCADA) applications. Supervisory control supports operator control of equipment, such as opening or closing a breaker. Data acquisition gathers telemetered data from various sources.  The subtypes of the Telemetry entity deliberately match the UCA and IEC 61850 definitions. 
|This package also supports alarm presentation but it is not expected to be used by other applications.
|
			
			visible_categories 	(list visibility_relationship_list
			    (object Visibility_Relationship
				quid       	"379E8380008E"
				supplier   	"Logical View::61970::Wires"
				quidu      	"35031AD100EB")
			    (object Visibility_Relationship
				quid       	"3BC630DE021F"
				supplier   	"Logical View::61970::Meas"
				quidu      	"379A700E0134"))
			exportControl 	"Public"
			subsystem  	"Component View::SCADA"
			quidu      	"3752FD860192"
			logical_models 	(list unit_reference_list
			    (object Class "CommunicationLink"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"351576BE03C0"
				documentation 	"The connection to remote units is through one or more communication links. Reduntant links may exist. The CommunicationLink class inherit PowerSystemResource. The intention is to allow CommunicationLinks to have Measurements. These Measurements can be used to model link status as operational, out of service, unit failure etc."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"35CE4E60001F"
					supplier   	"Logical View::61970::Core::PowerSystemResource"
					quidu      	"35031B8E0006"))
				module     	"Component View::SCADA::CommunicationLink (module spec)"
				quidu      	"3752FD8601CA"
				language   	"Java")
			    (object Class "RemoteUnit"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"35158540032A"
				documentation 	"A remote unit can be a RTU, IED, substation control system, control center etc. The communication with the remote unit can be through various standard protocols (e.g. IEC 61870, IEC 61850) or non standard protocols (e.g. DNP, RP570 etc.). A remote unit contain remote data points that might be telemetered, collected or calculated. The RemoteUnit class inherit PowerSystemResource. The intention is to allow RemotUnits to have Measurements. These Measurements can be used to model unit status as operational, out of service, unit failure etc."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"35CE4E6401E4"
					supplier   	"Logical View::61970::Core::PowerSystemResource"
					quidu      	"35031B8E0006"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "remoteUnitType"
					quid       	"3AC347EB0317"
					documentation 	"A remote unit can be a RTU, IED, substation control system, control center etc. "
					type       	"RemoteUnitType"
					quidu      	"3AC34811027B"
					exportControl 	"Public"))
				module     	"Component View::SCADA::RTU (module spec)"
				quidu      	"3752FD8601D1"
				language   	"Java")
			    (object Class "RemoteSource"
				quid       	"39DDD6D4012E"
				documentation 	"Remote sources are state variables that are telemetered or calculated within the remote unit."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3AC34B9900F5"
					supplier   	"Logical View::61970::SCADA::RemotePoint"
					quidu      	"3AC3459F0104"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "sensorMaximum"
					quid       	"39DDE6020073"
					documentation 	"The maximum value the telemetry item can return."
					type       	"Numeric"
					quidu      	"39DDCA8703CE"
					exportControl 	"Public")
				    (object ClassAttribute "sensorMinimum"
					quid       	"39DDE60A013E"
					documentation 	"The minimum value the telemetry item can return."
					type       	"Numeric"
					quidu      	"39DDCA8703CE"
					exportControl 	"Public")
				    (object ClassAttribute "scanInterval"
					quid       	"39DDE60F0228"
					documentation 	"The time interval between scans."
					type       	"Seconds"
					quidu      	"350376AE02A9"
					exportControl 	"Public")
				    (object ClassAttribute "deadband"
