			    (object Class_Category "TroubleTickets"
				quid       	"3D9CB5F901F6"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "TroubleTicket"
					quid       	"3AA805C80334"
					documentation 	
| A trouble ticket is a document which is used to report electrical trouble. The trouble may either be an outage or non-outage problem, such as power quality.  It must be always be associated with an Incident Record.
|
|Note that a separate Activity Record is created for each call associated with an instance of Trouble Ticket.  The time of a call is stored in ActivityRecord.createdOn and comments are recorded in ActivityRecord.remarks.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CDFA20190"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "typeOfTrouble"
						quid       	"3AA805C9005A"
						documentation 	" Code which describes the type of trouble."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "timeOfComm"
						quid       	"3AA805C901E0"
						documentation 	"Time trouble call first received.  The time of subsequent calls by the same customer for the same trouble are recorded in associated Activity Records."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "priority"
						quid       	"3AA805CA00BE"
						documentation 	" Priority of trouble call."
						type       	"EnumeratedType"
						exportControl 	"Public")
					    (object ClassAttribute "restorationTime"
						quid       	"3AA805CA0208"
						documentation 	" Time of restoration of resolution of trouble."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "hazardCode"
						quid       	"3D2714FB01D4"
						documentation 	"Code for a reported hazard condition."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "commBackERT"
						quid       	"3D299BD90154"
						documentation 	"Flag set true if person reporting trouble requested a communication back when sigificant information became available about cause of the outage and the estimated restoration time.  The person and their contact information is maintained in the assoicated Customer informaiton.  Communication back results are recorded in an assoicated ActivityRecord.remarks."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "commBackRestore"
						quid       	"3D29AC9A01F3"
						documentation 	"Flag set true if person reporting trouble requested a communication back when to confirm power has been restored.  The person and their contact information is maintained in the assoicated Customer informaiton.  communication back results are recorded in an assoicated ActivityRecord.remarks."
						type       	"boolean"
						exportControl 	"Public")
					    (object ClassAttribute "eRT"
						quid       	"40D824A7019C"
						documentation 	"Estimated restoration time last provided to customer."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "typeOfCommunication"
						quid       	"441ED8E7030D"
						documentation 	"Communication from a customer may be via telephone call, email, written letter, etc."
						type       	"String"
						quidu      	"40E534EE0080"
						initv      	"call"
						exportControl 	"Public")))
				    (object Class "Outage"
					quid       	"3AA805C000FA"
					documentation 	
| A planned outage involves network operations which will affect the supply of power to customers.
|
|Note that the list of Power System Resources for the Outage may be the same or a superset of the ones per OutageStep.  
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CDF9D00B4"
