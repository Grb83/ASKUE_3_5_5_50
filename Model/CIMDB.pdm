<a:Creator>sechin</a:Creator>
<a:ModificationDate>1201276008</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Current mode of operation, i.e., generator or condenser</a:Comment>
<a:DataType>NUMBER</a:DataType>
<a:Mandatory>1</a:Mandatory>
</o:Column>
<o:Column Id="o1804">
