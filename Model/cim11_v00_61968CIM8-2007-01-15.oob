<o:Class Id="o4047">
<a:ObjectID>DA04F86D-F579-4F32-9E0E-9FD1BFAC61E9</a:ObjectID>
<a:Name>ErpBankAccount</a:Name>
<a:Code>ErpBankAccount</a:Code>
