					exportControl 	"Public")
				    (object ClassAttribute "target"
					quid       	"4506CD7A029F"
					documentation 	"Contains or points to the specimen, region or station which is the object of the observation"
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "resultOf"
					quid       	"4506CD8000BB"
