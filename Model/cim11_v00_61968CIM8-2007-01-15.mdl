			    (object Class_Category "WorkInspectionMaintenance"
				quid       	"3F6F389F005A"
				documentation 	"Work Ispection and Maintenance Package."
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "MaintenanceDataSet"
					quid       	"3F68FF81022E"
					documentation 	"The result of a maintenance activity, a type of Procedure, for a given attribute of an asset is documentated in an MaintenanceDataSet. "
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"41F967F301D8"
						supplier   	"Logical View::61968::Assets::AssetWorkTrigger::DataSet"
						quidu      	"41F9677303A1"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "maintCode"
						quid       	"3F6900FE0005"
						documentation 	"Code for the type of maintenance performed."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "conditionBefore"
						quid       	"3F6901A302E7"
						documentation 	"Description of the condition of the asset just prior to maintenance being performed."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "conditionAfter"
						quid       	"3F6901C2006B"
						documentation 	"Condition of asset just following maintenance procedure."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "maintDate"
						quid       	"3F69021D0044"
						documentation 	"Date and time maintenance procedure was completed."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")))
				    (object Class "InspectionDataSet"
					quid       	"3AA8046C01A4"
					documentation 	"The result of one inspection, a type of Procedure, for a given attribute of an asset is documentated in an InspectionDataSet. "
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"41F967EB0173"
						supplier   	"Logical View::61968::Assets::AssetWorkTrigger::DataSet"
						quidu      	"41F9677303A1"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "status"
						quid       	"3AA8046D038E"
						documentation 	" Status of this attribute of the object for the time & date stated in inspectDate."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "locationConditions"
						quid       	"3F69035D02A7"
						documentation 	"A general description of the conditions of the location where the asset resides."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "inspectDate"
						quid       	"3F69041902CF"
						documentation 	"Date and time this inspections was completed."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")))
				    (object Class "Procedure"
					quid       	"3AA8046E0122"
					documentation 	
|A documented procedure for various types of Work or Work Tasks.  A compatible unit, a standard way of performing a unit of work, is guided by one or more procedures.   The type of procedure is defined in Procedure.type. For example, when type=Inspection, this procedure coupled with Schedule and other information provides the key items of an inspection plan.  Another type of Procedure is a Diagnosis.  Note that each specific values and settings to be used in a procedure is intended to be described in an instance of ProcedureValue.
|
|A maintenance ticket, a type of Work, is generated whenever maintenance is determined to be needed as a result of an inspection or diagnosis.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA815A101F4"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "code"
						quid       	"3AA8047002F8"
						documentation 	
| Code for this type of procedure.
|
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "sequenceNo"
						quid       	"3F68D2A801DC"
						documentation 	"The sequence number in a sequence of procedures being performed."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "procedureText"
						quid       	"3F71955B03A7"
						documentation 	"The textual description of the procedure, which references instances of ProcedureValue as appropriate."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "ProcedureValue"
					quid       	"3F7192CA0212"
					documentation 	"ProcedureValue is a name-value pair concept that provides the means for utilities to describe various values and settings to be used when performing proecdures on assets.  An example is to have an instance for each of the following settings when conducting a test: voltage, current, frequency, temperature."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3F71963700DC"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "valueType"
						quid       	"3F7193EF02B3"
						documentation 	"The type of value."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "property"
						quid       	"3F7193F300ED"
						documentation 	
| Describes what is the value means e.g. "3PhaseAmps", "KVA" etc 
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "value"
						quid       	"3F7193F60173"
						documentation 	" Value holds the actual value of for the procedure,"
						type       	"Float"
						quidu      	"39DDF1AA03DE"
						exportControl 	"Public")
					    (object ClassAttribute "units"
						quid       	"3F7193F90344"
						documentation 	" Units property is expressed in."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
