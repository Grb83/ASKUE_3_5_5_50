			quid       	"351578DA0294"
			documentation 	"A HostControlArea has a set of tie points and a set of generator controls (i.e., AGC). It also has a total load, including transmission and distribution losses."
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"3A0902F50238"
