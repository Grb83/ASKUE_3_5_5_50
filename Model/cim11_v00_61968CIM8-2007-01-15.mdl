						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "outageType"
						quid       	"414F3D6D0376"
						type       	"OutageType"
						quidu      	"414F3DCD036A"
						exportControl 	"Public")))
				    (object Class "OutageNotification"
					quid       	"3AA805B601A4"
					documentation 	" A document containing information to be sent to customers notifying that an outage will take place. This is used to generate mailing lists for customers."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3B9CDF98026C"
