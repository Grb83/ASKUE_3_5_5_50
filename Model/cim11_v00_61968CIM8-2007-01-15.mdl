		    (object Class_Category "Topology"
			quid       	"379A704B01A0"
			documentation 	"An extension to the Core Package that in association with the Terminal class models Connectivity, that is the physical definition of how equipment is connected together. In addition it models Topology, that is the logical definition of how equipment is connected via closed switches. The Topology definition is independent of the other electrical characteristics."
			visible_categories 	(list visibility_relationship_list
			    (object Visibility_Relationship
				quid       	"3BC630430302"
				supplier   	"Logical View::61970::Core"
				quidu      	"379A700802A8")
			    (object Visibility_Relationship
				quid       	"3BC6304E0037"
				supplier   	"Logical View::61970::Domain"
				quidu      	"35089BCD03C2"))
			exportControl 	"Public"
			subsystem  	"Component View::Topology"
			quidu      	"379E6F73020C"
			logical_models 	(list unit_reference_list
			    (object Class "ConnectivityNode"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Cim"
					name       	"NercClassProfile"
					value      	TRUE)
				    (object Attribute
					tool       	"Cim"
					name       	"NercProfile"
					value      	TRUE)
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"351578890140"
				documentation 	"Connectivity nodes are points where terminals of conducting equipment are connected together with zero impedance."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3A0944C80083"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D")
				    (object Inheritance_Relationship
					quid       	"4008778F0000"
					supplier   	"Logical View::61850::LNodeContainer"
					quidu      	"3EF7F14D0212"))
				module     	"Component View::Wires::ConnectivityNode (module spec)"
				quidu      	"3752FD860262"
				language   	"Java")
			    (object Class "TopologicalIsland"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"35158A68037A"
				documentation 	"An electrically connected subset of the network. Topological islands can change as the current network state changes (i.e., disconnect switches, breakers, etc. change state)."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3A094511014E"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				module     	"Component View::Wires::TopologicalIsland (module spec)"
				quidu      	"3752FD860279"
				language   	"Java")
			    (object Class "TopologicalNode"
				attributes 	(list Attribute_Set
				    (object Attribute
					tool       	"ReportGen"
					name       	"GenerateFlag"
					value      	"FALSE")
				    (object Attribute
					tool       	"Java"
					name       	"cg_style"
					value      	"Default_EJB"))
				quid       	"35158A7B037A"
				documentation 	"A set of connectivity nodes that, in the current network state, are connected together through any type of closed switches, including  jumpers. Topological nodes can change as the current network state changes (i.e., switches, breakers, etc. change state)."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3A0944DE016D"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "energized"
					quid       	"3527C65D00EC"
					documentation 	"True if node energized"
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
