	    (object Class_Category "EnergyScheduling"
		quid       	"35031AAE00CC"
		documentation 	"This package provides the capability to schedule and account for transactions for the exchange of electric power between companies. It includes transations for megawatts which are generated, consumed, lost, passed through, sold and purchased. These classes are used by Accounting and Billing for Energy, Generation Capacity, Transmission, and Ancillary Services. "
		visible_categories 	(list visibility_relationship_list
		    (object Visibility_Relationship
			quid       	"35EA095702DE"
			supplier   	"Logical View::61970::Generation::Production"
			quidu      	"35218ED30350")
		    (object Visibility_Relationship
			quid       	"37A4DF1800E2"
			supplier   	"Logical View::61970::Meas"
			quidu      	"379A700E0134"))
		exportControl 	"Public"
		subsystem  	"Component View::EnergyScheduling"
		quidu      	"3752FD860197"
		logical_models 	(list unit_reference_list
		    (object Class "DynamicSchedule"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"35157B1D0276"
			documentation 	"A continuously variable component of a control area's MW net interchange schedule. Dynamic schedules are sent and received by control areas."
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"45267C74007E"
				supplier   	"Logical View::61970::Core::RegularIntervalSchedule"
				quidu      	"4472D403038D"))
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "dynSchedSignRev"
				quid       	"3522EEE803C3"
				documentation 	"Dynamic schedule sign reversal required (yes/no)"
				type       	"Boolean"
				quidu      	"39FE8FDF00FD"
				exportControl 	"Public")
			    (object ClassAttribute "dynSchedStatus"
				quid       	"3522EEFF0041"
				documentation 	
|The "active" or "inactive" status of the dynamic schedule
				
				type       	"String"
				quidu      	"40E534EE0080"
