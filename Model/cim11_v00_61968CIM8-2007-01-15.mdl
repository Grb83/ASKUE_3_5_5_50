		    (object Class_Category "Core2"
			quid       	"3AA804D30050"
			documentation 	"The Core2 Package contains core functions needed for distribution management.  These core extensions were not sufficiently mature to standardize at the time IEC61970-301 was released as a draft standard, and therefore Core2 is being released as part of IEC 61968-11.  As is the case of the Core Package, these classes and relationships are intended to be used throughout the CIM.  "
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "Core2Version"
				quid       	"4509A9970177"
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "version"
					quid       	"4509A9A3033C"
					initv      	"Core2_v008")
				    (object ClassAttribute "date"
					quid       	"4509A9A6034B"
					initv      	"2006-09-15")))
			    (object Class_Category "ActivityRecords"
				quid       	"3AA804D3015E"
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "ActivityRecord"
					quid       	"3AA804D30384"
					documentation 	
|An ActivityRecord records activity for an Asset, Location, PowerSystemResource, Customer, ErpContact (e.g.,  operator, market participant, etc.), or other object at a point in time.  An activity may be for an event that has already occurred or for a planned activity.  
|The PowerSystemResource relationship records events regarding the logical function being provided by the resource in the electrical network (independent of the particular asset providing the function).  The Asset relationship records history about the particular equipment, independent of where it is currently being used in the electrical network.   The Location relationship records events associated with the geographical location.  The Customer relationship records history regarding the customer independent of the logical network or particular assets being used to serve the customer.
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3ABCB8870294"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "status"
						quid       	"3D221BA3017E"
						documentation 	
|Status at the time of "statusDateTime."  For an asset, this is new construction (installed, ready to be placed in operation), in-service, decommissioned (out-of-service), removed, existing, proposed abandoned, proposed install, proposed remove, proposed replace, unknown, other.
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "statusReason"
						quid       	"3D221BAB01B2"
						documentation 	"Reason code or explanation for why object went to this status."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "remarks"
						quid       	"3D221D8C0131"
						documentation 	
|Text that was recorded at the time specified in "statusDateTime."
						
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "statusDateTime"
						quid       	"40991826020D"
						documentation 	"Status as of this time and date."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")))
				    (object Class "History"
					quid       	"3AA804FC0334"
					documentation 	" List of Documents and/or Events which form a history."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA815C60352"
						supplier   	"Logical View::61968::Core2::Collections::Collection"
						quidu      	"3AA804EC02DA")))
				    (object Class "TimePoint"
					quid       	"4098F7290123"
					documentation 	"A point in time within a sequence of points in time relative to a TimeSchedule."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"40991D5C0157"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "relativeTimeInterval"
						quid       	"4098FD32025B"
						documentation 	"A point in time relative to a scheduled start time (TimeSchedule.subjectStatusDate).  Null if TimePoint is an absolute time or sequence based."
						type       	"Seconds"
						quidu      	"350376AE02A9"
						exportControl 	"Public")
					    (object ClassAttribute "absoluteTime"
						quid       	"4099208D0057"
						documentation 	"The absolute time and date for this time point. Typically manually entered if TimePoint is calendar based, derived if interval based or sequence based."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "sequenceNumber"
						quid       	"409921000021"
						documentation 	"The relative sequence number for this time point.  Null if TimePoint is interval based or an absolute time."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "windowStart"
						quid       	"40D83D3502D1"
						documentation 	"Beginning of the window of time that this time point is valid.  For example, seasonal, only on weekends, not on weekends, only 8:00 to 5:00, etc."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "windowEnd"
						quid       	"40D83D89017E"
						documentation 	"End of the window of time that this time point is valid.  "
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")))
				    (object Class "TimeSchedule"
					quid       	"4098F73B0238"
					documentation 	
|A "schedule" is used for anything that needs to be described in terms of how it changes through time.  An object of this class is used to perform a single-valued function of time. 
|
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"40991C8D031C"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "timeScheduleType"
						quid       	"40D83159034E"
						documentation 	"Type of time schedule such as: periodic (hourly, daily, weekly, monthly, etc.), day of the month, by date, calendar (specific times and dates)."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "recurrencePattern"
						quid       	"40D8353602A6"
						documentation 	"Specifies the interval at which an appointment repeats.   Example include: first Monday of every month; last day of the month; etc."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "recurrencePeriod"
						quid       	"40D83C7A030E"
						documentation 	"Seconds between time points, from the beinning of one period to the beginning of the next period.  Note that a device like a meter may have multiple interval periods (e.g., 1, 5, 15, 30, or 60 minutes)."
						type       	"Seconds"
						quidu      	"350376AE02A9"
						exportControl 	"Public")
					    (object ClassAttribute "scheduleStartDate"
						quid       	"40D98598008A"
						documentation 	" Schedule date."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "scheduleFinishDate"
						quid       	"40D985E401C9"
						documentation 	" Scheduled finish date."
						type       	"AbsoluteDateTime"
						quidu      	"35036D32004F"
						exportControl 	"Public")
					    (object ClassAttribute "offset"
						quid       	"4106D35D02AC"
						documentation 	"The offset from midnight (i.e., 0 hours, 0 minutes, 0 seconds) for the periodic time points to begin.  For example, for an interval meter that is set up for five minute intervals, setting recurrencePeriod=300 (5 minutes) and offset=120 (2 minutes) would result in scheduled events to read the meter executing at 2, 7, 12, 17, 22, 27, 32, 37, 42, 47, 52, and 57 minutes past each hour."
						type       	"Seconds"
						quidu      	"350376AE02A9"
						exportControl 	"Public")))
				    (object Class "ScheduledEvent"
					quid       	"4099177D0138"
					documentation 	"Signifies an event to trigger one or more activities, such as reading a meter, recalculating a bill, requesting work, when generating units must be scheduled for maintenance, when a transformers is scheduled to be refurbished, etc.."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"409917CF0118"
						supplier   	"Logical View::61970::Core::IdentifiedObject"
						quidu      	"39DD7D18015D"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "eventType"
						quid       	"40991E1001B0"
						documentation 	"The type of event that has been scheduled."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "eventDuration"
						quid       	"40D98BE30325"
						documentation 	"Duration of the scheduled event, for example, the time to ramp between values."
						type       	"Seconds"
