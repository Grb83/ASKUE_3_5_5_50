<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Meter form designation per ANSI C12.10 or other applicable standard.  An alphanumeric designation denoting the circuit arrangement for which the meter is applicable and its specific terminal arrangement.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
