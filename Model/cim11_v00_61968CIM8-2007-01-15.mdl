				    (object Class "MeterComModule"
					quid       	"42161C08002B"
					documentation 	"An AMR (automated meter reading) module is configured within a meter asset to support communication with an AMR system. Where a meter asset may only have the basic capability to measure usage, an AMR module often can augment the capabilites of the meter to provide for more advanced capabilities such as time of use, outage detection, load control, tamper detection, etc., as well as providing for two way communications with an AMR master station."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"4461BD5003B9"
						supplier   	"Logical View::61968::Assets::PointAssetHierarchy::ElectricalAsset"
						quidu      	"4461BCD80261"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "amrAddress"
						quid       	"427FD5EE031C"
