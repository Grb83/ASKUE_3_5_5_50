<o:Class Id="o8392">
<a:ObjectID>75402C54-B68B-4200-AC98-7E44904A5EED</a:ObjectID>
<a:Name>PassThroughBill</a:Name>
<a:Code>PassThroughBill</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Pass Through Bill is used for:
 1)Two sided charge transactions with or without ISO involvement (hence the “pass thru”)
2) Specific direct charges or payments that are calculated outside or provided directly to settlements
3) Specific charge bill determinants that are externally supplied and used in charge calculations

</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
