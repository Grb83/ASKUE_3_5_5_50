			    (object Class "GmlGraphic"
				quid       	"4505D70F02FD"
				documentation 	
|A "graphic symbol" with an inherent shape, color(s), and possibly size. A "graphic" can be very informally defined as "a little picture" and can be of either a raster or vector-graphic source type.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4506DEDA03B9"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "opacity"
					quid       	"4506A4BC0167"
					documentation 	
|Specifies the level of translucency to use when rendering the Graphic.The value is encoded as a floating-point value
|between 0.0 and 1.0 with 0.0 representing completely transparent and 1.0 representing completely opaque, with a linear scale of translucency for intermediate values. The default value is 1.0
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "size"
					quid       	"4506A4C503C8"
					documentation 	"Gives the absolute size of the graphic in pixels encoded as a floatingpoint number. The default size for an object is context-dependent. Negative values are not allowed."
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "minSize"
					quid       	"4507AA900157"
					documentation 	"The minimum symbol size allowed."
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "rotation"
					quid       	"4506A4CC02FD"
					documentation 	"Gives the rotation of a graphic in the clockwise direction about its center point in decimal degrees, encoded as a floating-point number. Negative values mean counter-clockwise rotation. The default value is 0.0 (no rotation). Note that there is no connection between source geometry types and rotations; the point used for plotting has no inherent direction. Also, the point within the graphic about which it is rotated is format dependent. If a format does not include an inherent rotation point, then the point of rotation should be the centroid."
					type       	"AngleDegrees"
					quidu      	"3508A1C9014E"
					exportControl 	"Public")
				    (object ClassAttribute "xScale"
					quid       	"4507AA680280"
					documentation 	"Horizontal scaling factor of normal symbol - particularly applicable to busbars if not described through a sequence of gmlPositions (e.g., Busbar)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "yScale"
					quid       	"4507AA72008C"
					documentation 	"Vertical scaling factor of normal symbol - particularly applicable to busbars if not described through a sequence of gmlPositions (e.g., Busbars)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "symbolID"
					quid       	"4507AA7701D4"
					documentation 	"The identifier of the symbol, if not derived from the type of CIM object (PSR, Asset, Organisation, Document, etc.) gmlSymbolPlacement is associated with."
					type       	"string"
					exportControl 	"Public")))
