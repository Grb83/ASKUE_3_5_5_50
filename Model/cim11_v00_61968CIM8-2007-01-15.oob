<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The service voltage at which the meter is designed to operate. Typical voltage ratings in North America are 120, 240, 277 or 480V. </a:Comment>
<a:DataType>Float</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
