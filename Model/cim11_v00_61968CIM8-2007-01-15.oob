<o:Package Id="o20">
<a:ObjectID>AA664D7F-8A03-422E-8F27-9ADD211E8F49</a:ObjectID>
<a:Name>EnergyScheduling</a:Name>
<a:Code>EnergyScheduling</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>This package provides the capability to schedule and account for transactions for the exchange of electric power between companies. It includes transations for megawatts which are generated, consumed, lost, passed through, sold and purchased. These classes are used by Accounting and Billing for Energy, Generation Capacity, Transmission, and Ancillary Services. </a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
