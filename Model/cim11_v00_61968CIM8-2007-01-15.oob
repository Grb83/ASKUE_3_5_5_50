<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Customer billing value = meter multiplier * transformer ratios * reading value.  The multiplier identifies the scaling value to apply to the reported value after delivery of the tagged item.</a:Comment>
<a:DataType>Float</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o1078">
