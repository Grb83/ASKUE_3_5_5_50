<a:Code>Fixed</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>the outage can not be rescheduled before actual start date is assigned</a:Comment>
<a:DataType>int</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o3481">
<a:ObjectID>D84128FD-AA58-4895-8C45-3C7794F095F1</a:ObjectID>
<a:Name>Flexible</a:Name>
<a:Code>Flexible</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>the outage can be rescheduled</a:Comment>
<a:DataType>int</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o3482">
<a:ObjectID>959CE08B-9CF0-46C8-B7EC-E331F7A96645</a:ObjectID>
<a:Name>Forced</a:Name>
<a:Code>Forced</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>unforeseen interruption in equipment service</a:Comment>
<a:DataType>int</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
