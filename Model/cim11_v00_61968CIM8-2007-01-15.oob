<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Frequency at which stated device ratings apply, typically 50 Hz or 60 Hz.</a:Comment>
<a:DataType>Frequency</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
