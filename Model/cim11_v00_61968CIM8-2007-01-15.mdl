						quidu      	"3AA80681005A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "budget"
						quid       	"3F70A40D0276"
						documentation 	"Overall project budget."
						type       	"Money"
						quidu      	"350C644500EB"
						exportControl 	"Public")))
				    (object Class "BusinessCase"
					quid       	"3CB4781D0334"
					documentation 	"Business justification for capital expenditures, usually addressing operations and maintenance costs as well."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3CB478AF020A"
						supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
