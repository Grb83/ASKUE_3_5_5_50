<c:Classes>
<o:Class Id="o6520">
<a:ObjectID>15DCE38C-7B9D-43A4-87DC-3206FBDC930F</a:ObjectID>
<a:Name>ConnectivityNode</a:Name>
<a:Code>ConnectivityNode</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Connectivity nodes are points where terminals of conducting equipment are connected together with zero impedance.</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
</o:Class>
<o:Class Id="o6518">
<a:ObjectID>EA7041F6-1936-4C92-92A1-0DB1A7F99CE6</a:ObjectID>
<a:Name>TopologicalIsland</a:Name>
<a:Code>TopologicalIsland</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>An electrically connected subset of the network. Topological islands can change as the current network state changes (i.e., disconnect switches, breakers, etc. change state).</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
</o:Class>
<o:Class Id="o6519">
<a:ObjectID>4778D72E-BD86-4B90-A67F-4C3DF1A964A7</a:ObjectID>
<a:Name>TopologicalNode</a:Name>
<a:Code>TopologicalNode</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A set of connectivity nodes that, in the current network state, are connected together through any type of closed switches, including  jumpers. Topological nodes can change as the current network state changes (i.e., switches, breakers, etc. change state).</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o6529">
<a:ObjectID>A24F5FC3-790E-4442-A435-1F5CD3282111</a:ObjectID>
<a:Name>energized</a:Name>
<a:Code>energized</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>True if node energized</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o6530">
<a:ObjectID>F08925C1-C4FB-41BB-90ED-B04A76300890</a:ObjectID>
<a:Name>loadCarrying</a:Name>
<a:Code>loadCarrying</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
