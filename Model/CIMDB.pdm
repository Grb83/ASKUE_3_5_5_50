<o:Column Id="o1303">
<a:ObjectID>E46E6D6D-C073-4057-8C5D-01FA20A421D6</a:ObjectID>
<a:Name>CONTROLDEADBAND</a:Name>
<a:Code>CONTROLDEADBAND</a:Code>
<a:CreationDate>1201276008</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1201276008</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Unit control error deadband. When a unit&#39;s desired MW change is less than this deadband, then no control pulses will be sent to the unit.</a:Comment>
<a:DataType>NUMBER</a:DataType>
<a:Mandatory>1</a:Mandatory>
</o:Column>
<o:Column Id="o1304">
<a:ObjectID>8CB84F30-A630-4089-BC68-7A305E11E14C</a:ObjectID>
