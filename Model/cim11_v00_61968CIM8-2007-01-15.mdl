		    (object Class_Category "Consumers"
			quid       	"3AA804AF0140"
			documentation 	"This package is used to define detailed customer models as are needed for 61968."
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object Class "WorkBillingInfo"
				quid       	"3AA804B803DE"
				documentation 	
| Billing information for work performed.  
|
|The history of Work Billing Info, Invoices, and Payments is to be maintained in associated ActivityRecords.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B1ECC95035C"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "issueDate"
					quid       	"3AA804B900A0"
					documentation 	" Date bill was issued to client."
					type       	"AbsoluteDateTime"
					quidu      	"35036D32004F"
					exportControl 	"Public")
				    (object ClassAttribute "dueDate"
					quid       	"3AA804B901E0"
					documentation 	" Date by which payment for bill is expected from client."
					type       	"AbsoluteDateTime"
					quidu      	"35036D32004F"
					exportControl 	"Public")
				    (object ClassAttribute "receivedDate"
					quid       	"3AA804BA00FA"
					documentation 	" Date payment was received from client."
					type       	"AbsoluteDateTime"
					quidu      	"35036D32004F"
					exportControl 	"Public")
				    (object ClassAttribute "workPrice"
					quid       	"3AA804BA0244"
					documentation 	" Amount of bill."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "costEstimate"
					quid       	"3BC6220101F4"
					documentation 	"Estimated cost for work. "
					type       	"Money"
					quidu      	"350C644500EB"
					exportControl 	"Public")
				    (object ClassAttribute "deposit"
					quid       	"3BC622160032"
					documentation 	"Amount of price on deposit."
					type       	"Money"
					quidu      	"350C644500EB"
					exportControl 	"Public")
				    (object ClassAttribute "discount"
					quid       	"3BC6222A0096"
					documentation 	"Discount from standard price."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")))
			    (object Class "CustomerAccount"
				quid       	"3AA804C0019A"
				documentation 	"The CustomerAccount defines the assignment of a group of products and services purchased by the Customer through a CustomerAgreement.  A CustomerAccount collects together the Service Agreements, Security Agreements, Contract Agreements, and Non-Service Agreeements to create billings(invoices) for a Customer and receive  payment on those Agreements.  It is used as a mechanism for customer billing and payment."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B8FAF5F0000"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "billingCycle"
					quid       	"3AA804C003B6"
					documentation 	"Billing cycle identifies cycle day on which the related Customer Account will normally be billed.  It is used in determining when to produce the billing statement for the Customer Account."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "budgetBill"
					quid       	"3AA804C200DC"
					documentation 	" Budget bill code."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "status"
					quid       	"3C8F6B010064"
					documentation 	"Status of customer account: Active, Final, To Be Final (final bill has not been generated yet), Other"
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "CustomerAgreement"
				quid       	"3AA804C20294"
				documentation 	"The CustomerAgreement is an agreement between the Customer and the utility to pay for service at a specific ServiceLocation.  The Service Agreement, a type of CustomerAgreement, records certain billing information about the type of service provided at the ServiceLocation.  It is used during charge creation to determine the type of Service.  CustomerAccount contains common information from the various types of ServiceAgreements."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3ECA3C2F0120"
					supplier   	"Logical View::61968::Core2::TopLevel::Agreement"
					quidu      	"35036BB4029F"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "typeService"
					quid       	"3C6A786500D2"
					documentation 	"The type of service that supports the customer agreement: electric single-rate, electric time-of-use, streetlight, other."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "PowerQualityPricing"
				quid       	"3AA804CD0280"
				documentation 	"Pricing can be based on power quality.  "
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B9D14DB006E"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "normalHighVoltLimit"
					quid       	"3AA804CD032A"
					documentation 	" Normal high voltage limit (p.u. V)"
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "normalLowVoltLimit"
					quid       	"3AA804CE00BE"
					documentation 	" Normal low voltage limit (p.u. V)"
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "emergencyHighVoltLimit"
					quid       	"3AA804CE0208"
					documentation 	" Emergency high voltage limit (p.u. V)"
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "emergencyLowVoltLimit"
					quid       	"3AA804CE0352"
					documentation 	" Emergency low voltage limit (p.u. V)"
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "valueUninterruptedServiceKW"
					quid       	"3AA804CF00B4"
					documentation 	" Value of uninterrupted service (Cost per kW)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "valueUninterruptedServiceKWh"
					quid       	"3AA804CF01FE"
					documentation 	" Value of uninterrupted service (Cost per kWh)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "voltLimitViolCost"
					quid       	"3AA804D0006E"
					documentation 	" Voltage limit violation cost (Cost per unit Voltage)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "voltImbalanceViolCost"
					quid       	"3AA804D001B8"
					documentation 	" Voltage imbalance violation cost (Cost per unit Voltage)."
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")
				    (object ClassAttribute "powerFactorMin"
					quid       	"3B1FFFB20398"
					documentation 	
|This specifies the threshold minimum power factor for a Pricing Structure.  It is specified in instances where a special charge is levied if the actual power factor for a Service falls below the value specified in this attribute.    
|	
					
					type       	"Float"
					quidu      	"39DDF1AA03DE"
					exportControl 	"Public")))
			    (object Class "Tariff"
				quid       	"3AA804D00370"
				documentation 	" A document, approved by the responsible regulatory agency, listing the terms and conditions, including a schedule of prices, under which utility services will be provided.  The Tariff has a unique number within the state or province.  For Rate Schedules it is frequently allocated by the affiliated Public Utilities Commission. "
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B8FAF850078"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "startDate"
					quid       	"3AA804D20028"
					documentation 	" Date tarrif was activated."
					type       	"AbsoluteDate"
					exportControl 	"Public")
				    (object ClassAttribute "endDate"
					quid       	"3AA804D20172"
					documentation 	" Date tarrif was terminated.  Value is null if tarrif is active."
					type       	"AbsoluteDate"
					exportControl 	"Public")))
			    (object Class "CustomerData"
				quid       	"3AA804F3028A"
				documentation 	"A Customer is a type of Organisation.  For that type of Organisation, CustomerData is required for services supplied by other Organisations.  Note that many of the fields sommonly associated with a customer are defined in ERP classes, such as ErpPerson."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"441ACD71032C"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "specialNeeds"
					quid       	"3AA804F40212"
					documentation 	"Does overall customer (vs. ErpPerson) have special service needs? Examples include life support, hospitals, etc."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "vip"
					quid       	"3AA804F4035C"
					documentation 	" Is this an important customer, aside from any other special needs?"
					type       	"boolean"
					exportControl 	"Public")
				    (object ClassAttribute "customerType"
					quid       	"3B1486830154"
					documentation 	"Type of customer.  Examples include: residential, residential & commercial, residential & streetlight, residential-streetlight-others, residential-farm-service, commercial-industrial, pumping load,wind machine, energy service supplier, energy service scheduler, other, internal use."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "pucNumber"
					quid       	"3B1E91C80140"
					documentation 	"Public Utility Commission identification number, if applicable."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "StandardIndustryCode"
				quid       	"3B1E81290046"
				documentation 	
|The Standard Industrial Classification are the codes that identify the type of products/service an industry is      involved in.  For example, in the USA these codes are located by the federal government, and then published in a book entitled "The Standard Industrial Classification Manual".  The codes are arranged in a hierarchical structure.  It is used for statutory reporting purposes.
|
|Note that Residential Service Agreements are not classified according to the SIC codes. 
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B8FAF7A0316"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "code"
					quid       	"3B1E81A90258"
					documentation 	"SIC Code is a standard alphanumeric code assigned to a particular product/service within an industry.  "
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "ExternalCustomerAgreement"
				quid       	"3B1EBF5300F0"
				documentation 	"A type of customer agreement involving an external agency.  For example, a customer may form a contracts with an Energy Service Supplier if Direct Access is permitted."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B1EBFFD037A"
					supplier   	"Logical View::61968::Consumers::CustomerAgreement"
					quidu      	"3AA804C20294")))
			    (object Class "PricingStructure"
				quid       	"3B1FFBA60398"
				documentation 	"A grouping of pricing components and prices used in the creation of customer charges and the eligibility criteria under which these terms may be offered to a customer.  The reasons for grouping includes state, customer classification, site characteristics, classification (i.e. fee price structure, deposit price structure, electric service price structure, etc.) and accounting requirements. "
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B1FFC1F0028"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "code"
					quid       	"3B1FFC5E01E0"
					documentation 	
|Code is a unique user-allocated key for a Pricing  Structure.  It is used by company representatives to identify the correct price structure for allocating to a customer.  For rate schedules it is often prefixed by a state code.   
|	
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "taxExemption"
					quid       	"3B2001CF01B8"
					documentation 	"The Tax Exemption Indicator is the indicator that specifies whether the Pricing Structure is taxable or not.  true=Taxable Pricing Structure, false=Non-Taxable Pricing Structure               "
					type       	"boolean"
					exportControl 	"Public")
				    (object ClassAttribute "dailyEstUsage"
					quid       	"3B20024402F8"
					documentation 	"Daily Estimate Usage Quantity is a manually entered usage quantity typically entered by customer accounting.  It is used in place of actual computed estimated average when history of usage is not available. "
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "dailyCeilingUsage"
					quid       	"3B20034302DA"
					documentation 	"Daily Ceiling Usage Quantity is the absolute maximum valid non-demand usage quantity used in validating a customer's billed non-demand usage.  "
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "dailyFloorUsage"
					quid       	"3B20038402C6"
					documentation 	"Daily Floor Usage Quantity is the absolute minimum valid non-demand usage quantity used in validating a customer's billed non-demand usage. "
					type       	"Integer"
					quidu      	"40E514C202C2"
					exportControl 	"Public")
				    (object ClassAttribute "revenueClass"
					quid       	"3B201FF5015E"
					documentation 	
|Revenue Class is an accounting classification of the type of revenue collected for the Customer Agreement.   It is typically used to break down accounts for revenue accounting.  Typical classes include: Residential, Non-residential, Commercial, Industrial, Irrigation, Street Light, Other.
|
|Revenue Class is often used to determine the grace period allowed, before collection actions are taken on a customer. (grace periods vary between revenue classes)   
|	
					
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")))
			    (object Class "CustomerBillingInfo"
				quid       	"3B200C0B033E"
				documentation 	
|The creation of the monthly customer billing statements is the method employed to notify Customers of charges, adjustments and credits applied to their account for Services and Products.  The actuall billing occurs through an ErpInvoice.  The CustomerBillingInfo includes information from the payment, collection, meter reading, installed meter, service, site, customer, customer account, customer agreement, services and pricing subject areas.   Each component price shows up as a separate line item on the ErpInvoice.
|
|The Customer Billing Statement may include collection and account messages, marketing/civic event messages and bill inserts. 
|One Customer Billing Statement is produced for all Agreements under a Customer Account per billing month.  The Customer Billing Statement is produced on the billing cycle date assigned to a Customer Account.    
|
|The history of Customer Billing Info, Invoices, and Payments is to be maintained in associated ActivityRecords.
				
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"3B2012A7035C"
					supplier   	"Logical View::61968::Documentation::DocumentInheritance::Document"
					quidu      	"3AA80681005A"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "billingDate"
					quid       	"3B201024019A"
					documentation 	"The business date designated for the billing run which produced the Customer Billing Statement. "
					type       	"AbsoluteDate"
					exportControl 	"Public")
				    (object ClassAttribute "dueDate"
					quid       	"3B2011D6028A"
					documentation 	"Due Date contains the calculated date upon which a Customer Billing amount is due, which is used in the invoicing process.  It is used to determine when a Customer's Payment is delinquent.  This due date takes into consideration the regulatory criteria and the Customer's requested due date.  In the absence of a Customer requested due date, this statement due date is typically calculated from the regulated number of days and the bill date of the Customer Billing Statement. "
					type       	"AbsoluteDate"
					exportControl 	"Public")
				    (object ClassAttribute "outBalance"
					quid       	"3B20108C0370"
					documentation 	
|This is the outstanding balance on the Customer Account as of the statement date.   
|	
					
					type       	"Money"
					quidu      	"350C644500EB"
					exportControl 	"Public")
				    (object ClassAttribute "pymtPlanAmt"
					quid       	"3B20110501B8"
					documentation 	"This is the monthly amortized amount due during each billing cycle for the Customer Account balance for which the Payment Plan is set-up.  "
					type       	"Money"
					quidu      	"350C644500EB"
					exportControl 	"Public")
				    (object ClassAttribute "pymtPlanType"
					quid       	"3B2011510046"
					documentation 	"Type of payment plan."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "billingType"
					quid       	"3B20171502B2"
					documentation 	"Customer receives a (1) consolidated bill from energy service supplier (ESS), (2) consolidated bill from utility distribution compnay (UDC), (3) separate bills from  ESS and UDC, (4) other."
					type       	"String"
					quidu      	"40E534EE0080"
					exportControl 	"Public")
				    (object ClassAttribute "lastPaymentDate"
					quid       	"3C6E75C301F4"
					documentation 	"The details of each payment are tracked in the ERP system.  However, the date of the last payment received from the customer is retained in CustomerBilling."
					type       	"AbsoluteDate"
					exportControl 	"Public")
				    (object ClassAttribute "lastPaymentAmt"
					quid       	"3C6E771D032A"
