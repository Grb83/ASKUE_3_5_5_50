<a:Modifier>sechin</a:Modifier>
<a:Comment>TRUE when the meter and AMR system have the means to detect and monitor reverse flow.</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
