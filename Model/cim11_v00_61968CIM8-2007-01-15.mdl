		    (object Class "InadvertentAccount"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"35157ED40262"
			documentation 	"An account for tracking inadvertent interchange versus time for each control area. A control area may have more than one inadvertent account in order to track inadvertent over one or more specific tie points in addition to the usual overall net inadvertent. Separate accounts would also be used to track designated time periods, such as on-peak and off-peak."
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"36D15D0E00D7"
				supplier   	"Logical View::61970::Generation::Production::AccountBalance"
				quidu      	"36D15CC5030D"))
			module     	"Component View::EnergyScheduling::InadvertentAccount (module spec)"
			quidu      	"3752FD8602AB"
			language   	"Java")
		    (object Class "AreaReserveSpec"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"3515726D01E0"
			documentation 	"The control area's reserve specification"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "areaReserveSpecName"
				quid       	"3521918701E2"
				documentation 	"The Identification or name of the control area's reserve specification.  A particular specification could correspond to pre-defined power system conditions, e.g., emergency situations."
				type       	"String"
				quidu      	"40E534EE0080"
				exportControl 	"Public")
			    (object ClassAttribute "lowerRegMarginReqt"
				quid       	"352191A70008"
				documentation 	"Lower regulating margin requirement in MW, the amount of generation that can be dropped by control in 10 minutes"
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public")
			    (object ClassAttribute "opReserveReqt"
				quid       	"352191D200DC"
				documentation 	"Operating reserve requirement in MW, where operating reserve is the generating capability that is fully available within 30 minutes. Operating reserve is composed of primary reserve (t less than 10 min) and secondary reserve (10 less than t less than 30 min)."
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public")
			    (object ClassAttribute "primaryReserveReqt"
				quid       	"352191EE037B"
				documentation 	"Primary reserve requirement in MW, where primary reserve is generating capability that is fully available within 10 minutes. Primary reserve is composed of spinning reserve and quick-start reserve."
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public")
			    (object ClassAttribute "raiseRegMarginReqt"
				quid       	"3521920C01BC"
				documentation 	"Raise regulating margin requirement in MW, the amount of generation that can be picked up by control in 10 minutes"
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public")
			    (object ClassAttribute "spinningReserveReqt"
				quid       	"352192320030"
				documentation 	"Spinning reserve requirement in MW, spinning reserve is generating capability that is presently synchronized to the network and is fully available within 10 minutes"
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public"))
			module     	"Component View::EnergyScheduling::AreaReserveSpec (module spec)"
			quidu      	"3752FD8602AE"
			language   	"Java")
		    (object Class "HostControlArea"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
