<a:CreationDate>1002869504</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1201097552</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:ServerCheckExpression>(NFULLHOURS IS NULL OR NFULLHOURS BETWEEN 0 AND (LAST_DAY(TO_DATE(NACCPERIOD,&#39;YYYYMM&#39;))-TO_DATE(NACCPERIOD,&#39;YYYYMM&#39;)+1)*24) AND (NWORKINGHOURS IS NULL OR NWORKINGHOURS BETWEEN 0 AND (LAST_DAY(TO_DATE(NACCPERIOD,&#39;YYYYMM&#39;))-TO_DATE(NACCPERIOD,&#39;YYYYMM&#39;)+1)*24) AND NWORKINGHOURS &lt;= NFULLHOURS</a:ServerCheckExpression>
