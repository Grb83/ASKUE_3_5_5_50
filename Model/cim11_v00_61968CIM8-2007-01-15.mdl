			    (object Class_Category "PointAssetHierarchy"
				quid       	"3AE717FA0250"
				documentation 	"Point assets package."
				exportControl 	"Public"
				logical_models 	(list unit_reference_list
				    (object Class "SwitchAssetModel"
					quid       	"3AA804A703C0"
					documentation 	
|Documentation for a type of a switch asset of a particular product model made by a manufacturer (Organisation).  There are typically many instances of an asset associated with a single asset model.
|
					
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA815A90276"
						supplier   	"Logical View::61968::Assets::PointAssetHierarchy::ElectricalAssetModel"
						quidu      	"3AA804670028")))
				    (object Class "Streetlight"
					quid       	"3AA804A20212"
					documentation 	"Streetlight asset."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"4461BCED032C"
						supplier   	"Logical View::61968::Assets::PointAssetHierarchy::ElectricalAsset"
						quidu      	"4461BCD80261"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "lightRatingActual"
						quid       	"3AA804A202EE"
						documentation 	" Power rating of light."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "Tool"
					quid       	"3AA804A80348"
					documentation 	"A tool is a type of utility asset typically used by utility resources like crews and persons (ErpPersons).  As is the case for other assets, tools must be maintained."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AE721D10343"
						supplier   	"Logical View::61968::Assets::AssetBasics::Asset"
						quidu      	"3AA8045102DA"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "lastCalibrationDate"
						quid       	"3AA804A9000A"
						documentation 	" Date the tool was last caibrated, if applicable."
						type       	"AbsoluteDate"
						exportControl 	"Public")))
				    (object Class "Vehicle"
					quid       	"3AA804AC0352"
					documentation 	" A vehicle is a type of utility asset."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA8159F001E"
						supplier   	"Logical View::61968::Assets::AssetBasics::Asset"
						quidu      	"3AA8045102DA"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "vehicleType"
						quid       	"451AEDBC0251"
						documentation 	"The general categorization  type of vehicle: crew, user, contractor, other.  Note: (1) the vehicle model is defined by VehicleAssetModel and (2) Specific people and organizations and their roles relative to this vehicle may be determined by the inherited Asset-ErpPerson and Asset-Organization associations."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "ElectricalAssetModel"
					quid       	"3AA804670028"
					documentation 	"A device asset is the physical asset used to perform the conducting equipment's role.  It is associated with ConductingEquipment of the Wiresl Package"
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA815A9019A"
						supplier   	"Logical View::61968::Assets::AssetBasics::AssetModel"
						quidu      	"3AA804A90186")))
				    (object Class "MeterAssetModel"
					quid       	"3AA8048A008C"
					documentation 	"Documentation for a type of an meter asset of a particular product model made by a manufacturer (Organisation).   These types of meters are used to measure power consumption.  There are typically many instances of an asset associated with a single asset model."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"3AA8159B0316"
						supplier   	"Logical View::61968::Assets::PointAssetHierarchy::ElectricalAssetModel"
						quidu      	"3AA804670028"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "regRatio"
						quid       	"3AA8048A0276"
						documentation 	" Meter register ratio."
						type       	"Float"
						quidu      	"39DDF1AA03DE"
						exportControl 	"Public")
					    (object ClassAttribute "noWires"
						quid       	"3AA8048A03C0"
						documentation 	" Number of wires."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "noDials"
						quid       	"3AA8048B03B6"
						documentation 	" Number of meter dials."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "form"
						quid       	"3AA8048C0118"
						documentation 	" Meter form number."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "kH"
						quid       	"427FCAD602AF"
						documentation 	"Meter kh (watthour) constant. This constant is the number of watthours that must be applied to the meter to cause one disk revolution for an electromechanical meter or the number of watthours represented by one increment pulse for an electronic meter."
						type       	"Float"
						quidu      	"39DDF1AA03DE"
						exportControl 	"Public")
					    (object ClassAttribute "numDigits"
						quid       	"427FCC6700FA"
						documentation 	"The number of dials on the meter register for an electromechanical meter; for an electronic meter, the number of digits on the meter display."
						type       	"Integer"
						quidu      	"40E514C202C2"
						exportControl 	"Public")
					    (object ClassAttribute "timeOfUseMeter"
						quid       	"427FD2F000BB"
						documentation 	"True when the meter or meter+AMR module are capable of offering TOU data."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "kwhMeter"
						quid       	"427FD3170251"
						documentation 	"True when the meter is capable of metering real energy in kWh."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "kVAhMeter"
						quid       	"427FD34901F4"
						documentation 	"True when the meter is capable of metering apparent energy in kVAh."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "demandMeter"
						quid       	"427FD378038A"
						documentation 	"True when the meter or installed AMR option is capable of capturing demand data."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "reactiveMeter"
						quid       	"427FD3A102FD"
						documentation 	"True when the meter is capable of metering reactive energy in kVArh."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "qMeter"
						quid       	"427FD3D900EA"
						documentation 	"True when the meter is capable of metering reactive energy in kQh."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "loadProfileMeter"
						quid       	"427FD40503A9"
						documentation 	"True when the meter or the installed AMR option is capable of capturing kWh interval data."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")
					    (object ClassAttribute "intervalDataMeter"
						quid       	"427FD43202DE"
						documentation 	"TRUE when the meter or the installed AMR option is capable of capturing interval data for a user selectable measurement. The measurement might be kWh, Volts, or some other billing or engineering quantity."
						type       	"Boolean"
						quidu      	"39FE8FDF00FD"
						exportControl 	"Public")))
