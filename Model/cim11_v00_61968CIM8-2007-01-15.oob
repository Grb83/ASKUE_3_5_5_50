<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The time zone offset (in minutes) relative to GMT for the location of the meter.</a:Comment>
<a:DataType>Integer</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o1128">
<a:ObjectID>48193D3F-AA89-4CF1-B5B8-AF358B593F93</a:ObjectID>
<a:Name>dstEnabled</a:Name>
<a:Code>dstEnabled</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>TRUE when the AMR module is configured to enable the autonomous application of daylight savings time (DST).</a:Comment>
