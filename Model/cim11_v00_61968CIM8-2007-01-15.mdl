			quid       	"351585C60294"
			documentation 	"A type of agreement that provides the default method by which interchange schedules are to be integrated to obtain hourly MWh schedules for accounting. "
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
