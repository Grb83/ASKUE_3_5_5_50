					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "code"
						quid       	"4432B5990222"
						documentation 	"The code for this circuit.  Some companies use this attribute to identify the circuit colour used for reference by operators, draftsmen, etc. on displays, maps, etc."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "ratedKV"
