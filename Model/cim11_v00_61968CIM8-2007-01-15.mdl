	    (object Class_Category "Reservation"
		quid       	"3648E2DA01B5"
		documentation 	"This package includes information for Transaction Scheduling for Energy, Generation Capacity, Transmission, and Ancillary Services."
		exportControl 	"Public"
		subsystem  	"Component View::Reservation"
		quidu      	"3752FD860198"
		logical_models 	(list unit_reference_list
		    (object Class "AncillaryService"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"36CD474A0067"
			documentation 	
|All of these services relate 
|to various aspects of insuring that the production of energy matches consumption of energy at any given time.  They are very critical to the security and reliability of the interconnected network. Some examples of AncillaryServices include Operating/Supplemental Reserve, Energy Imbalance Service, Operating/Spinning Reserve, Reactive Supply and Voltage Control, and Regulation and Frequency Response.
			
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"3A094356018C"
				supplier   	"Logical View::61970::Core::IdentifiedObject"
				quidu      	"39DD7D18015D"))
			module     	"Component View::Reservation::AncillaryService (module spec)"
			quidu      	"3752FD8602B7"
			language   	"Java")
		    (object Class "TransmissionService"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"36CD475A004C"
			documentation 	"Transmission products along posted transmission path."
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"3A094A040303"
				supplier   	"Logical View::61970::Core::IdentifiedObject"
				quidu      	"39DD7D18015D"))
			module     	"Component View::Reservation::TransmissionService (module spec)"
			quidu      	"3752FD8602B8"
			language   	"Java")
		    (object Class "TransmissionPath"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"35158B79032A"
			documentation 	"An electrical connection, link, or line consisting of one or more parallel transmission elements between two areas of the interconnected electric systems, or portions thereof. TransmissionCorridor and TransmissionRightOfWay refer to legal aspects. The TransmissionPath refers to the segments between a TransmissionProvider's ServicePoints."
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "availTransferCapability"
				quid       	"3527C9E60198"
				documentation 	"The available transmission capability of a transmission path for the reference direction"
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public")
			    (object ClassAttribute "parallelPathFlag"
				quid       	"3527CA0C0124"
				documentation 	
|Flag which indicates if the transmission path is also a designated interconnection "parallel path"
				
				type       	"Boolean"
				quidu      	"39FE8FDF00FD"
				exportControl 	"Public")
			    (object ClassAttribute "totalTransferCapability"
				quid       	"3527CA2302D6"
				documentation 	"The total transmission capability of a transmission path in the reference direction"
				type       	"ActivePower"
				quidu      	"350890990101"
				exportControl 	"Public"))
			module     	"Component View::Reservation::TransmissionPath (module spec)"
			quidu      	"3752FD8602B9"
			language   	"Java")
		    (object Class "ServicePoint"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"351585F10262"
			documentation 	"Each ServicePoint is contained within (or on the boundary of) an ElectronicIinterchangeArea. ServicePoints are defined termination points of a transmission path (down to distribution level or to a customer - generation or consumption or both). "
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"3A09436B00E1"
				supplier   	"Logical View::61970::Core::IdentifiedObject"
				quidu      	"39DD7D18015D"))
			module     	"Component View::Reservation::ServicePoint (module spec)"
			quidu      	"3752FD8602BA"
			language   	"Java")
		    (object Class "ServiceReservation"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"36CD43AC014C"
			documentation 	"A ServiceReservation is a reservation for either AncillaryServices or TransmissionServices. In the case of TransmissionServices, this is the right to some amount of AvailableTransmissionCapacity for a product on a path in a direction for some specific period of time"
			module     	"Component View::Reservation::ServiceReservation (module spec)"
			quidu      	"3752FD8602BB"
			language   	"Java")
		    (object Class "TiePoint"
			attributes 	(list Attribute_Set
			    (object Attribute
				tool       	"ReportGen"
				name       	"GenerateFlag"
				value      	"FALSE")
			    (object Attribute
				tool       	"Java"
				name       	"cg_style"
				value      	"Default_EJB"))
			quid       	"35158A4A023A"
			documentation 	"Site of an interface between interchange areas. The tie point can be a network branch (e.g., transmission line or transformer) or a switching device. For transmission lines, the interchange area boundary is usually at a designated point such as the middle of the line. Line end metering is then corrected for line losses."
			superclasses 	(list inheritance_relationship_list
			    (object Inheritance_Relationship
				quid       	"3A09437F0083"
				supplier   	"Logical View::61970::Core::IdentifiedObject"
				quidu      	"39DD7D18015D"))
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "tiePointMWRating"
