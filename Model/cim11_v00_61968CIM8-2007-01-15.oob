<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Generic TypeAsset for all types of component in the network that have electrical characteristics</a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
</o:Class>
<o:Class Id="o1726">
<a:ObjectID>6F0B30FA-4D6A-481D-9B54-257242F97B8E</a:ObjectID>
