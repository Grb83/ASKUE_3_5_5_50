<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Firm interchange flag indicates whether or not this energy transaction can be changed without potential financial consequences.</a:Comment>
<a:DataType>Boolean</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o8830">
<a:ObjectID>70C92CFC-8399-42FA-8B42-F87A6AA07FFC</a:ObjectID>
<a:Name>state</a:Name>
<a:Code>state</a:Code>
