					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "rightOfWayType"
						quid       	"3AA8052A001E"
						documentation 	" Type of ROW."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")
					    (object ClassAttribute "propertyData"
						quid       	"3AA8052B015E"
						documentation 	" Property related information that describes the ROW's land parcel.  For example, it may be a deed book number, deed book page number, and parcel number."
						type       	"String"
						quidu      	"40E534EE0080"
						exportControl 	"Public")))
				    (object Class "ServiceLocation"
					quid       	"3AA8052B02DA"
					documentation 	"Service location.  For residential or most businesses, it is typically the location of the meter on the utility customer's premises.  For transmission, it is the point(s) of interconnection on the transmission provider's transmission system where capacity and/or energy transmitted by the transmission provider is made available to the receiving party. The point(s) of delivery is specified in the Service Agreement."
					superclasses 	(list inheritance_relationship_list
					    (object Inheritance_Relationship
						quid       	"435CDDAE007D"
						supplier   	"Logical View::61968::Core2::Locations::Location"
						quidu      	"3AA80517019A"))
					class_attributes 	(list class_attribute_list
					    (object ClassAttribute "serviceLocCode"
