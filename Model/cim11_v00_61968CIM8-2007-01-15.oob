<o:Class Id="o1702">
<a:ObjectID>63DA2D67-2E49-43BA-B921-7CCE0A3676A4</a:ObjectID>
<a:Name>StructuralTypeAsset</a:Name>
<a:Code>StructuralTypeAsset</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>A Type of Structural Asset with properties common to a large number of asset models. </a:Comment>
<a:UseParentNamespace>0</a:UseParentNamespace>
<a:Persistence>T</a:Persistence>
<a:Cardinality>*</a:Cardinality>
<c:Attributes>
<o:Attribute Id="o1744">
<a:ObjectID>AD62C48C-2044-4158-96D4-F32134064082</a:ObjectID>
<a:Name>material</a:Name>
<a:Code>material</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Material the structure is made of: e.g. wood, steel, concrete</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o1745">
<a:ObjectID>4B38DCAC-E00D-4270-B958-58A3F4D902A3</a:ObjectID>
<a:Name>ratedKV</a:Name>
<a:Code>ratedKV</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The maximum rated voltage of the equipment that can be mounted on/contained within the structure.</a:Comment>
<a:DataType>Voltage</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
</o:Class>
<o:Class Id="o1701">
<a:ObjectID>97089DB9-D841-4B3C-A363-FB698F643DDD</a:ObjectID>
<a:Name>MountingPoint</a:Name>
<a:Code>MountingPoint</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Point on a structure that a connection may have a conductor  connected to. Defined with an x and y coordinate plus a phase. A connection may have multiple mounting points, one for each phases</a:Comment>
