<a:Text>CREATE TRIGGER TR_geofence_event_argument_geofence   ON geofence   FOR DELETE   AS    DELETE FROM geofence_event_argument WHERE gate_event_argument_id IN (SELECT gate_event_argument_id FROM DELETED );
