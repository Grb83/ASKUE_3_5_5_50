<a:Text>CREATE TRIGGER FK_device_def_template_msg_field_dict_set_null   ON msg_field_dictionary   FOR DELETE   AS    UPDATE device_def SET template_msg_field_dict_id = NULL    WHERE template_msg_field_dict_id IN (SELECT msg_field_dict_id FROM DELETED);
