			    (object Class "Quality61850"
				quid       	"3A8C2C6301EF"
				documentation 	"Quality flags in this class are as defined in IEC 61850, except for estimatorReplaced, which has been included in this class for convenience."
				superclasses 	(list inheritance_relationship_list
				    (object Inheritance_Relationship
					quid       	"4472B4DC0125"
					supplier   	"Logical View::61970::Core::IdentifiedObject"
					quidu      	"39DD7D18015D"))
				class_attributes 	(list class_attribute_list
				    (object ClassAttribute "validity"
					quid       	"3A8C2D8A0049"
					documentation 	"Validity may be good, questionable or invalid. Refer to the Validity enumeration for more details."
					type       	"Validity"
					quidu      	"3A8C2FA2027B"
					initv      	"GOOD"
					exportControl 	"Public")
				    (object ClassAttribute "overFlow"
					quid       	"3A8C2E5B03A4"
					documentation 	"Measurement value is beyond the capability of being  represented properly. For example, a counter value overflows from maximum count back to a value of zero. "
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "outOfRange"
					quid       	"3A8C2E6802AA"
					documentation 	"Measurement value is beyond a predefined range of value."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "badReference"
					quid       	"3A8C2E770143"
					documentation 	"Measurement value may be incorrect due to a reference being out of calibration."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "oscillatory"
					quid       	"3A8C2E820308"
					documentation 	
|To prevent some overload of the communication it is sensible to detect and suppress oscillating (fast changing) binary inputs. If a signal changes in a defined time (tosc) twice in the same direction (from 0 to 1 or from 1 to 0) then oscillation is detected and the detail quality identifier "oscillatory" is set. If it is detected a configured numbers of transient changes could be passed by. In this time the validity status "questionable" is set. If after this defined numbers of changes the signal is still in the oscillating state the value shall be set either to the opposite state of the previous stable value or to a defined default value. In this case the validity status "questionable" is reset and "invalid" is set as long as the signal is oscillating. If it is configured such that no transient changes should be passed by then the validity status "invalid" is set immediately in addition to the detail quality identifier "oscillatory" (used for status information only).
					
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "failure"
					quid       	"3A8C2E96027B"
					documentation 	"This identifier indicates that a supervision function has detected an internal or external failure, e.g. communication failure."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "oldData"
					quid       	"3A8C2E9E02AA"
					documentation 	"Measurement value is old and possibly invalid, as it has not been successfully updated during a specified time interval."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "suspect"
					quid       	"3A8C2EA8021D"
					documentation 	"A correlation function has detected that the value is not consitent with other values. Typically set by a network State Estimator."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					exportControl 	"Public")
				    (object ClassAttribute "test"
					quid       	"3A8C2EDC0172"
					documentation 	"Measurement value is transmitted for test purposes."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					initv      	"FALSE"
					exportControl 	"Public")
				    (object ClassAttribute "operatorBlocked"
					quid       	"3A8C2EF3026C"
					documentation 	"Measurement value is blocked and hence unavailable for transmission. "
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					initv      	"FALSE"
					exportControl 	"Public")
				    (object ClassAttribute "source"
					quid       	"3A8C2F1A03E3"
					documentation 	"Source gives information related to the origin of a value. The value may be acquired from the process, defaulted or substituted."
					type       	"Source"
					quidu      	"3A8C2FCD01EF"
					initv      	"PROCESS"
					exportControl 	"Public")
				    (object ClassAttribute "estimatorReplaced"
					quid       	"3A8C34AF029A"
					documentation 	"Value has been replaced by State Estimator. estimatorReplaced is not an IEC61850 quality bit but has been put in this class for convenience."
					type       	"Boolean"
					quidu      	"39FE8FDF00FD"
					initv      	"FALSE"
					exportControl 	"Public")))
