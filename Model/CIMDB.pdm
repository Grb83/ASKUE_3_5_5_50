<a:Name>POSITIVEFLOWIN</a:Name>
<a:Code>POSITIVEFLOWIN</a:Code>
<a:CreationDate>1201276008</a:CreationDate>
<a:Creator>sechin</a:Creator>
<a:ModificationDate>1201276008</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>If true then this measurement is a MW, MVAR or AMPS with the convention that a positive value measured at the Terminal means power is flowing into the related PowerSystemResource.</a:Comment>
<a:DataType>NUMBER</a:DataType>
<a:Mandatory>1</a:Mandatory>
</o:Column>
