<a:Creator>sechin</a:Creator>
<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>Maximum amount of energy per day which can be produced during the trading period in MWh</a:Comment>
<a:DataType>ActivePower</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o8404">
<a:ObjectID>703BC455-2CAF-4A01-B5CD-09D58A2FA30C</a:ObjectID>
