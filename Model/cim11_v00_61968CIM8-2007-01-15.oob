<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment>The type of diagram, for example, schematic, geographic, internal view (e.g., inside a vault or cabinet), design sketch, etc.</a:Comment>
<a:DataType>String</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
</c:Attributes>
