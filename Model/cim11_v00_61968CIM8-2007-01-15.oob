<a:ModificationDate>1202478865</a:ModificationDate>
<a:Modifier>sechin</a:Modifier>
<a:Comment> Value of uninterrupted service (Cost per kWh).</a:Comment>
<a:DataType>Float</a:DataType>
<a:Persistent>0</a:Persistent>
</o:Attribute>
<o:Attribute Id="o2051">
<a:ObjectID>15432696-2637-4819-BDD1-353EABF11B12</a:ObjectID>
<a:Name>voltLimitViolCost</a:Name>
<a:Code>voltLimitViolCost</a:Code>
<a:CreationDate>1202478865</a:CreationDate>
