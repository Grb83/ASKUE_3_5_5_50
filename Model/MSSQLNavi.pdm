<a:Code>TR_reack_info1</a:Code>
<a:Text>CREATE TRIGGER TR_reack_info1   ON track_info   FOR DELETE   AS    UPDATE track_recorder SET track_info_id = NULL WHERE track_info_id IN (SELECT track_info_id FROM DELETED) ;
